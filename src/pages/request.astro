---
/**
 * /request — the ONE «ثبت درخواست» wizard, 8 steps (site-credit-noinst v1.0 + v1.1). Minimal chrome, no sticky bar,
 * noindex, excluded from sitemap + robots. ?plan=&term=, ?amount=, ?src= and utm_* deep links keep working (ApplyWizard).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ApplyWizard from '../components/islands/ApplyWizard';
import I from '../components/ui/I.astro';
import { LOAN_PLANS_SNAPSHOT } from '../lib/loan-plans.snapshot';
import '../styles/apply-wizard.css';
---

<BaseLayout title="ثبت درخواست وام" description="درخواست وام نفیس وام در چند قدم کوتاه؛ بدون کد پیامکی و بدون هزینه." noindex minimal hideStickyBar src="request">
  <div class="container-nf rq-layout apw-main">
    <ApplyWizard client:load snapshot={LOAN_PLANS_SNAPSHOT} />
    <aside class="rq-aside wz-aside" aria-label="بعد از ثبت درخواست">
      <div class="box">
        <h2>بعد از ثبت چه می‌شود؟</h2>
        <ol>
          <li>جواب‌هایتان به دست کارشناس نفیس وام می‌رسد.</li>
          <li>کارشناس با شما تماس می‌گیرد و طرح‌های مناسب را بررسی می‌کند.</li>
          <li>اگر طرحی مناسب بود، مدارک را با راهنمایی کارشناس آماده می‌کنید.</li>
        </ol>
      </div>
      <div class="box safe">
        <I name="shield" size={20} />
        <span>ثبت درخواست هزینه ندارد و کد پیامکی نمی‌خواهد. کارشناس‌های ما هیچ‌وقت رمز کارت یا کد یک‌بارمصرف نمی‌خواهند.</span>
      </div>
    </aside>
  </div>
</BaseLayout>
