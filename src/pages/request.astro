---
/** /request (mockup request.html): minimal chrome, no sticky bar, noindex, excluded from sitemap + robots. */
import BaseLayout from '../layouts/BaseLayout.astro';
import RequestWizard from '../components/islands/RequestWizard';
import I from '../components/ui/I.astro';
import { LOAN_PLANS_SNAPSHOT } from '../lib/loan-plans.snapshot';
import { pickerTrigger } from '../data/experts';
---

<BaseLayout title="درخواست وام" description="درخواست وام و مشاوره رایگان نفیس وام در کمتر از یک دقیقه؛ بدون تعهد." noindex minimal hideStickyBar src="request">
  <div class="container-nf rq-layout">
    <RequestWizard client:load snapshot={LOAN_PLANS_SNAPSHOT} />
    <aside class="rq-aside" aria-label="بعد از ثبت درخواست">
      <div class="nf-card aside-card">
        <h2>بعد از ثبت چه می‌شود؟</h2>
        <ol class="steps" style="margin-top:8px">
          <li><span>کارشناس نفیس وام با شما تماس می‌گیرد و شرایط را توضیح می‌دهد</span></li>
          <li><span>مدارک را آنلاین یا حضوری تحویل می‌دهید</span></li>
          <li><span>پس از تأیید، تسهیلات طبق شرایط طرح پرداخت می‌شود</span></li>
        </ol>
      </div>
      <div class="nf-card aside-card">
        <p>ترجیح می‌دهید همین حالا صحبت کنید؟</p>
        <a class="nf-btn nf-btn--secondary nf-btn--block" {...pickerTrigger('call')}><I name="phone" size={18} /> تماس با کارشناس</a>
      </div>
    </aside>
  </div>
</BaseLayout>
