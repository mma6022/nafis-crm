---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/ui/Section.astro';
import { SITE, WORK_HOURS } from '../lib/site';
import { breadcrumbLd } from '../lib/seo';
const crumbs = [
  { name: 'خانه', path: '/' },
  { name: 'شرایط استفاده', path: Astro.url.pathname },
];
---

<BaseLayout
  title="شرایط استفاده"
  description="شرایط و قوانین استفاده از وب‌سایت و خدمات مشاوره تسهیلات نفیس وام."
  jsonLd={[breadcrumbLd(crumbs)]}
>
  <PageHeader title="شرایط استفاده" crumbs={crumbs} />
  <Section>
    <div class="prose-nf">
      <p>
        این سایت متعلق به نفیس وام ({SITE.legalName}) است. با استفاده از سایت، شرایط زیر را
        می‌پذیرید.
      </p>
      <h2>خدمت ما</h2>
      <p>
        نفیس وام برای دریافت تسهیلات از بانک‌ها و پلتفرم‌های همکار مشاوره می‌دهد و شما را در مسیر درخواست همراهی می‌کند.
        تصمیم نهایی درباره‌ی پرداخت تسهیلات با بانک یا پلتفرم ارائه‌دهنده است.
      </p>
      <h2>اعداد سایت حدودی است</h2>
      <p>
        مبلغ دریافتی، قسط ماهانه و زمان بررسی که در سایت، ماشین‌حساب و طرح‌یاب می‌بینید حدودی است. مبلغ قطعی پس از
        اعتبارسنجی اعلام می‌شود و شرایط هر طرح در قرارداد همان طرح آمده است.
      </p>
      <h2>ثبت درخواست</h2>
      <p>
        ثبت فرم در سایت هیچ تعهدی برای شما ایجاد نمی‌کند و به معنی تأیید تسهیلات هم نیست. با ثبت شماره، موافقت می‌کنید
        کارشناس نفیس وام برای مشاوره با شما تماس بگیرد.
      </p>
      <h2>اطلاعات درست</h2>
      <p>لطفاً نام و شماره‌ی خودتان را وارد کنید. درخواست با شماره‌ی شخص دیگر بدون اجازه‌ی او پیگیری نمی‌شود.</p>
      <h2>ارتباط با ما</h2>
      <p>
        برای هر سؤال درباره‌ی این شرایط <a href="/contact/#callback">درخواست مشاوره‌ی رایگان</a> بگذارید تا کارشناس در ساعت کاری
        ({WORK_HOURS.shortFa}) با شما تماس بگیرد، یا به <a href={`mailto:${SITE.email}`} dir="ltr">{SITE.email}</a> ایمیل بزنید.
      </p>
    </div>
  </Section>
</BaseLayout>
