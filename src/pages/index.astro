---
/**
 * Home (designer mockup home.html, UX-SPEC §8). Copy + FAQ from src/content/pages/home.mdx; every number from plan
 * data (snapshot at build, live JSON in the browser). No testimonials section until real, consented reviews exist.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import HeroSample from '../components/islands/HeroSample';
import PlanFinder from '../components/islands/PlanFinder';
import HomeCalc from '../components/islands/HomeCalc';
import I from '../components/ui/I.astro';
import FaqList from '../components/FaqList.astro';
import PostCard from '../components/blog/PostCard.astro';
import { KEYWORD_PAGES, MESSENGERS, SITE } from '../lib/site';
import { LOAN_PLANS_SNAPSHOT } from '../lib/loan-plans.snapshot';
import { fa, fillFacts, planFacts } from '../lib/plans';
import { financialServiceLd, faqLd } from '../lib/seo';
import { getPosts, homePosts } from '../lib/blog';
import type { SpriteIcon } from '../components/ui/I';

const HOME_FAQ_MAX = 4; // PM: max 4 questions on home (home.mdx order) + link to /faq
const page = (await getCollection('pages', (p) => p.data.slug === '/'))[0]!;
const facts = planFacts(LOAN_PLANS_SNAPSHOT);
const fill = (s: string) => fillFacts(s, facts);
const faq = page.data.faq.slice(0, HOME_FAQ_MAX).map((f) => ({ q: fill(f.q), a: fill(f.a) }));
const posts = homePosts(await getPosts());
const SVC_ICON: Record<string, SpriteIcon> = {
  'vam-fori': 'bolt',
  'vam-bedun-zamen': 'user-x',
  'vam-bedun-chek': 'doc-x',
  'vam-ba-chek': 'doc',
  'vam-ba-safte': 'pen',
  'kharid-aghsati': 'cart',
};
---

<BaseLayout rawTitle title={fill(page.data.title)} description={page.data.description} src="home" jsonLd={[financialServiceLd(), faqLd(faq)]}>
  <Hero facts={facts} h1={page.data.h1}>
    <HeroSample client:media="(min-width: 1024px)" snapshot={LOAN_PLANS_SNAPSHOT} />
  </Hero>

  <section class="finder" id="plan-finder" aria-labelledby="finder-h">
    <div class="wrap">
      <div class="finder-head">
        <h2 id="finder-h">طرح مناسب‌تان را در ۳ قدم پیدا کنید</h2>
        <span class="nf-badge nf-badge--brand" style="white-space:nowrap;margin-top:2px"><span data-plan-count="planCount">{fa(facts.planCount)}</span> طرح فعال</span>
      </div>
      <div class="finder-mount" id="finder">
        <PlanFinder client:load snapshot={LOAN_PLANS_SNAPSHOT} src="home-finder" />
      </div>
    </div>
  </section>

  <section class="sec trustwhy" aria-labelledby="why-h" style="padding-top:40px">
    <div class="container-nf">
      <h2 id="why-h" class="vh">چرا نفیس وام؟</h2>
      <div class="trust">
        <div class="t"><span class="ph">[جای‌خالی: سال‌های فعالیت]</span></div>
        <div class="t"><span class="ph">[جای‌خالی: تعداد مشتری]</span></div>
        <div class="t"><b data-plan-count="planCount">{fa(facts.planCount)}</b> طرح فعال</div>
        <div class="t">همکاری با <b data-plan-count="bankCount">{fa(facts.bankCount)}</b> بانک و موسسه</div>
        <div class="t"><span class="ph">[جای‌خالی: نماد اینماد]</span></div>
      </div>
      <ul class="why2">
        <li><span class="ic"><I name="layers" /></span><span>یک طرح برای هر شرایط<small>با <span data-plan-count="planCount">{fa(facts.planCount)}</span> طرح فعال، احتمال اینکه طرحی متناسب با شما داشته باشیم زیاد است.</small></span></li>
        <li><span class="ic"><I name="eye" /></span><span>قسط روشن از روز اول<small>مبلغ اسمی، مبلغ قابل دریافت و قسط را قبل از هر تصمیمی می‌بینید.</small></span></li>
        <li><span class="ic"><I name="chat" /></span><span>کارشناس واقعی، نه ربات<small>یک نفر از تیم ما شرایط شما را می‌شنود و راهنمایی می‌کند.</small></span></li>
        <li><span class="ic"><I name="shield" /></span><span>بدون غافلگیری قبل از امضا<small>همه شرایط را قبل از امضای قرارداد می‌دانید.</small></span></li>
      </ul>
    </div>
  </section>

  <section class="sec" aria-labelledby="svc-h">
    <div class="container-nf">
      <div class="sec-head"><h2 id="svc-h">خدمات نفیس وام</h2></div>
      <div class="svc">
        {
          KEYWORD_PAGES.map((k) => (
            <a href={`/${k.slug}`}>
              <span class="ic"><I name={SVC_ICON[k.slug] ?? 'doc'} /></span>
              <div>
                <b>{k.label}</b>
                <span class="d">
                  {k.slug === 'kharid-aghsati' ? (
                    <><span data-plan-count="goodsCount">{fa(facts.goodsCount)}</span> طرح خرید کالا به‌صورت قسطی</>
                  ) : (
                    k.blurb
                  )}
                  {'marker' in k && <> <span class="ph">{k.marker}</span></>}
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="steps-h">
    <div class="container-nf">
      <div class="sec-head"><h2 id="steps-h">از درخواست تا دریافت، در ۳ قدم</h2></div>
      <ol class="steps3">
        <li><span class="ic"><I name="search" /></span>طرح مناسب را پیدا کنید</li>
        <li><span class="ic"><I name="phone" /></span>کارشناس تماس می‌گیرد و مدارک را تحویل می‌دهید</li>
        <li><span class="ic"><I name="check" /></span>واریز وام یا تحویل کالا</li>
      </ol>
      <div class="steps-cta"><a class="nf-btn nf-btn--text" href="/request?src=home-steps">شروع درخواست <I name="arrow" size={18} /></a></div>
    </div>
  </section>

  <section class="sec" aria-labelledby="calc-h" id="calculator">
    <div class="container-nf">
      <HomeCalc client:visible snapshot={LOAN_PLANS_SNAPSHOT} />
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="sec" aria-labelledby="blog-h">
        <div class="container-nf">
          <div class="sec-head">
            <h2 id="blog-h">مجله نفیس</h2>
            <a class="nf-btn nf-btn--text" href="/blog">همه مقاله‌ها</a>
          </div>
          <div class="posts">
            {posts.map((p) => (
              <PostCard post={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="sec" aria-labelledby="faq-h">
    <div class="container-nf faq-wrap">
      <div class="sec-head" style="display:block">
        <h2 id="faq-h">سؤالات متداول</h2>
        <p>جواب سؤالی را پیدا نکردید؟ <a href={SITE.tel}>تماس بگیرید</a>.</p>
      </div>
      <FaqList items={faq} />
      <div class="faq-more"><a class="nf-btn nf-btn--text" href="/faq">همه سؤالات متداول <I name="arrow" size={18} /></a></div>
    </div>
  </section>

  <section class="sec">
    <div class="container-nf">
      <div class="final">
        <div>
          <h2>هنوز مطمئن نیستید کدام طرح مناسب شماست؟</h2>
          <p>یک کارشناس رایگان راهنمایی‌تان می‌کند.</p>
        </div>
        <div class="row">
          <a class="nf-btn on-dark" href="/request?need=help&src=home-final">درخواست مشاوره رایگان</a>
          <a class="nf-btn nf-btn--secondary" href={MESSENGERS.whatsapp.href} data-todo="whatsapp"><I name="wa" size={20} /> واتساپ</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
