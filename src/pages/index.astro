---
/**
 * Home (designer mockup home.html, UX-SPEC §8). Copy + FAQ from src/content/pages/home.mdx; every number from plan
 * data (snapshot at build, live JSON in the browser). No testimonials section until real, consented reviews exist.
 * Order + rhythm: Armita home-order v1.0.1 FINAL (index.html sha256 1185c150…, HANDOFF §2): slider first (slide 1 = h2),
 * «صفر تا صد» (the only h1), why, finder, calculator, callback, mid 1, services, steps, blog, mid 2, FAQ. Spacing, content width
 * and section headings come only from styles/home-order.css (main.ho); no copy/colour/brand change.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlider from '../components/home/HeroSlider.astro';
import HeroSefr from '../components/home/HeroSefr.astro';
import MidBanner from '../components/home/MidBanner.astro';
import PlanFinder from '../components/islands/PlanFinder';
import HomeCalc from '../components/islands/HomeCalc';
import CallbackForm from '../components/islands/CallbackForm';
import I from '../components/ui/I.astro';
import FaqList from '../components/FaqList.astro';
import PostCard from '../components/blog/PostCard.astro';
import { KEYWORD_PAGES, TRUST_STATS } from '../lib/site';
import { LOAN_PLANS_SNAPSHOT } from '../lib/loan-plans.snapshot';
import { fa, fillFacts, planFacts } from '../lib/plans';
import { financialServiceLd, faqLd } from '../lib/seo';
import { fillFaq } from '../lib/faq-fill';
import { getPosts, homePosts } from '../lib/blog';
import '../styles/home-order.css';
import type { SpriteIcon } from '../components/ui/I';

const HOME_FAQ_MAX = 4; // PM: max 4 questions on home (home.mdx order) + link to /faq
const page = (await getCollection('pages', (p) => p.data.slug === '/'))[0]!;
const facts = planFacts(LOAN_PLANS_SNAPSHOT);
const fill = (s: string) => fillFacts(s, facts);
const faq = fillFaq(page.data.faq.slice(0, HOME_FAQ_MAX), LOAN_PLANS_SNAPSHOT);
const posts = homePosts(await getPosts());
const SVC_ICON: Record<string, SpriteIcon> = {
  'vam-fori': 'bolt',
  'vam-bedun-zamen': 'user-x',
  'vam-bedun-chek': 'doc-x',
  'vam-ba-chek': 'doc',
  'vam-ba-safte': 'pen',
  'kharid-aghsati': 'cart',
};
---

<BaseLayout mainClass="ho" rawTitle title={fill(page.data.title)} titleTemplate={page.data.title} description={page.data.description} src="home" jsonLd={[financialServiceLd(), faqLd(faq)]}>
  <HeroSlider facts={facts} firstH1={false} />
  <HeroSefr />

  <section class="rv sec trustwhy" aria-labelledby="why-h">
    <div class="container-nf">
      <h2 id="why-h">چرا نفیس وام؟</h2>
      <div class="trust">
        {/* 3 confirmed stats + live plan count + the اینماد chip (same self-hosted badge + link as the footer; the bar scrolls sideways on mobile). */}
        {TRUST_STATS.map((t) => <div class="t">{t.pre} <b>{t.b}</b> {t.post}</div>)}
        <div class="t"><b data-plan-count="planCount">{fa(facts.planCount)}</b> طرح فعال</div>
        <a class="t t-enamad" href="https://trustseal.enamad.ir/?id=734294" target="_blank" rel="noopener" referrerpolicy="origin"><img src="/images/enamad.png" alt="نماد اعتماد الکترونیکی" width="40" height="40" decoding="async" />دارای نماد اعتماد (اینماد)</a>
      </div>
      <ul class="why2">
        <li><span class="ic"><I name="layers" /></span><span>یک طرح برای هر شرایط<small>با <span data-plan-count="planCount">{fa(facts.planCount)}</span> طرح فعال، احتمال اینکه طرحی متناسب با شما داشته باشیم زیاد است.</small></span></li>
        <li><span class="ic"><I name="eye" /></span><span>قسط روشن از روز اول<small>مبلغ واریزی، قسط و تعداد اقساط را قبل از هر تصمیمی می‌بینید.</small></span></li>
        <li><span class="ic"><I name="chat" /></span><span>کارشناس واقعی، نه ربات<small>یک نفر از تیم ما شرایط شما را می‌شنود و راهنمایی می‌کند.</small></span></li>
        <li><span class="ic"><I name="shield" /></span><span>بدون غافلگیری قبل از امضا<small>همه شرایط را قبل از امضای قرارداد می‌دانید.</small></span></li>
      </ul>
    </div>
  </section>

  <section class="finder" id="plan-finder" aria-labelledby="finder-h">
    <div class="wrap">
      <div class="finder-head">
        <h2 id="finder-h">طرح مناسب‌تان را در ۲ قدم پیدا کنید</h2>
        <span class="nf-badge nf-badge--brand" style="white-space:nowrap;margin-top:2px"><span data-plan-count="planCount">{fa(facts.planCount)}</span> طرح فعال</span>
      </div>
      <div class="finder-mount" id="finder">
        <PlanFinder client:load snapshot={LOAN_PLANS_SNAPSHOT} src="home-finder" />
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="calc-h" id="calculator">
    <div class="container-nf">
      <HomeCalc client:visible snapshot={LOAN_PLANS_SNAPSHOT} />
    </div>
  </section>

  <section class="cb-sec" id="callback" aria-label="درخواست مشاوره‌ی رایگان">
    <div class="container-nf"><CallbackForm client:visible variant="section" src="home-callback" wa /></div>
  </section>

  <MidBanner n={1} eb="قدم بعدی" h="طرح مناسب را پیدا کردید؟" p="درخواست‌تان را در چند دقیقه ثبت کنید؛ کارشناس برای ادامه با شما تماس می‌گیرد." cta="ثبت درخواست" href="/request/?src=home-mid-1" />

  <section class="rv sec" aria-labelledby="svc-h">
    <div class="container-nf">
      <div class="sec-head"><h2 id="svc-h">خدمات نفیس وام</h2></div>
      <div class="svc">
        {
          KEYWORD_PAGES.map((k) => (
            <a href={`/${k.slug}/`}>
              <span class="ic"><I name={SVC_ICON[k.slug] ?? 'doc'} /></span>
              <div>
                <b>{k.label}</b>
                <span class="d">
                  {k.slug === 'kharid-aghsati' ? (
                    <><span data-plan-count="planCount">{fa(facts.planCount)}</span> طرح تسهیلات اقساطی</>
                  ) : (
                    k.blurb
                  )}
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="rv sec" aria-labelledby="steps-h">
    <div class="container-nf">
      <div class="sec-head"><h2 id="steps-h">از درخواست تا دریافت، در ۳ قدم</h2></div>
      <ol class="steps3">
        <li><span class="ic"><I name="search" /></span>طرح مناسب را پیدا کنید</li>
        <li><span class="ic"><I name="phone" /></span>کارشناس تماس می‌گیرد و مدارک را تحویل می‌دهید</li>
        <li><span class="ic"><I name="check" /></span>پرداخت تسهیلات طبق شرایط طرح</li>
      </ol>
      <div class="steps-cta"><a class="nf-btn nf-btn--text" href="/request/?src=home-steps">شروع درخواست <I name="arrow" size={18} /></a></div>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="rv sec" aria-labelledby="blog-h">
        <div class="container-nf">
          <div class="sec-head">
            <h2 id="blog-h">مجله نفیس</h2>
            <a class="nf-btn nf-btn--text" href="/blog/">همه مقاله‌ها</a>
          </div>
          <div class="posts">
            {posts.map((p) => (
              <PostCard post={p} dot />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <MidBanner n={2} eb="امنیت شما" h="با آرامش، مراقب کلاهبرداری باشید" p="فقط از راه‌های رسمی همین سایت با کارشناس‌ها در تماس باشید و کد یک‌بارمصرف یا رمز کارت را به هیچ‌کس ندهید." cta="راه‌های رسمی ارتباط" href="/contact/" />

  <section class="sec" aria-labelledby="faq-h">
    <div class="container-nf faq-wrap">
      <div class="sec-head" style="display:block">
        <h2 id="faq-h">سؤالات متداول</h2>
        <p>جواب سؤالی را پیدا نکردید؟ <a href="/contact/#callback">درخواست مشاوره‌ی رایگان بگذارید</a>.</p>
      </div>
      <FaqList items={faq} bindPlanCount={fa(facts.planCount)} />
      <div class="faq-more"><a class="nf-btn nf-btn--text" href="/faq/">همه سؤالات متداول <I name="arrow" size={18} /></a></div>
    </div>
  </section>

  <script>
    // one open callback form per page: once the finder shows its result (with its own inline form), hide the home section
    document.getElementById('finder')?.addEventListener('finder:result', () => {
      const s = document.getElementById('callback');
      if (s) s.hidden = true;
    });

    // home-order v1.0.1 §4: on the home page the mobile sticky bar waits until the slider's bottom edge has scrolled
    // above the bar's top edge (the bar is display:none ≥1024px, so this only matters below that). No JS → bar as before.
    const hero = document.getElementById('hero');
    const bar = document.querySelector<HTMLElement>('.bar');
    if (hero && bar) {
      document.body.classList.add('ho-bar-wait');
      let raf = 0;
      const update = () => {
        raf = 0;
        // the bar's resting top edge (it is fixed to the bottom; ignore its own hide transform)
        const barTop = window.innerHeight - bar.offsetHeight;
        document.body.classList.toggle('ho-bar-on', hero.getBoundingClientRect().bottom <= barTop);
      };
      const queue = () => {
        if (!raf) raf = requestAnimationFrame(update);
      };
      // IntersectionObserver wakes us while the slider crosses the viewport; scroll and viewport changes keep the edge exact
      new IntersectionObserver(queue, { threshold: [0, 0.25, 0.5, 0.75, 1] }).observe(hero);
      addEventListener('scroll', queue, { passive: true });
      window.onresize = queue; // (property, not the event-name string: Tailwind would read that word as a utility)
      update();
    }
  </script>
</BaseLayout>
