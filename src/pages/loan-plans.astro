---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/ui/Section.astro';
import LoanPlansList from '../components/islands/LoanPlansList';
import { LOAN_PLANS_SNAPSHOT } from '../lib/loan-plans.snapshot';
import { breadcrumbLd } from '../lib/seo';
const crumbs = [
  { name: 'خانه', path: '/' },
  { name: 'طرح‌های وام', path: '/loan-plans' },
];
---

<BaseLayout
  title="طرح‌های فعال وام و تسهیلات"
  description="فهرست به‌روز طرح‌های فعال وام کالایی و امتیازی نفیس وام: مبلغ، بانک، مدت اقساط، قسط ماهانه و زمان پرداخت."
  jsonLd={[breadcrumbLd(crumbs)]}
>
  <PageHeader
    title="طرح‌های فعال وام"
    lead="فهرست زنده از CRM نفیس وام. مبالغ برآوردی‌اند و پس از اعتبارسنجی قطعی می‌شوند."
    crumbs={crumbs}
  />
  <Section>
    <LoanPlansList client:load snapshot={LOAN_PLANS_SNAPSHOT} />
  </Section>
</BaseLayout>
