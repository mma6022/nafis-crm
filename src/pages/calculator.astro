---
/**
 * /calculator (UX-SPEC §7, designer ANSWERS-1 §9): type → band → term, 1–3 result cards (مبلغ دریافتی / مبلغ هر قسط / تعداد اقساط), FAQ.
 * The long 18-plan <select> is gone; money is shown as «حدود ۳۱۵ میلیون تومان», never «۳۱۵,۰۰۰,۰۰۰».
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import FaqList from '../components/FaqList.astro';
import FinalCTA from '../components/FinalCTA.astro';
import LoanCalculator from '../components/islands/LoanCalculator';
import { LOAN_PLANS_SNAPSHOT } from '../lib/loan-plans.snapshot';
import { breadcrumbLd, faqLd } from '../lib/seo';
const crumbs = [
  { name: 'خانه', path: '/' },
  { name: 'محاسبه قسط', path: '/calculator' },
];
/** P3-B: the FAQ answer is fixed verbatim (scripts/check-guarantees.mjs checks it in the HTML and FAQPage JSON-LD). */
const CALC_FAQ_ANSWER =
  'مبلغی که ماشین‌حساب نشون می‌ده، مبلغیه که به دستت می‌رسه، و جزئیات دقیقش رو کارشناس توی مشاوره‌ی رایگان توضیح می‌ده.';
const faq = [
  { q: 'مبلغی که ماشین‌حساب نشون می‌ده چیه؟', a: CALC_FAQ_ANSWER },
  { q: 'عدد ماشین‌حساب قطعی است؟', a: 'نه. مبلغ قطعی پس از اعتبارسنجی اعلام می‌شود.' },
];
---

<BaseLayout
  title="محاسبه قسط وام"
  description="با محاسبه‌گر قسط نفیس وام نوع، حدود مبلغ و مدت بازپرداخت را انتخاب کنید و مبلغ قابل دریافت و قسط ماهانه طرح‌های نزدیک را ببینید."
  jsonLd={[breadcrumbLd(crumbs), faqLd(faq)]}
>
  <PageHeader title="محاسبه قسط وام" lead="نوع، مبلغ و مدت را انتخاب کنید؛ نزدیک‌ترین طرح‌های فعال را با قسط تقریبی نشان می‌دهیم." crumbs={crumbs} />
  <div class="container-nf pt-8">
    <LoanCalculator client:load snapshot={LOAN_PLANS_SNAPSHOT} />
  </div>
  <section class="container-nf pt-section" aria-labelledby="calc-faq-h">
    <h2 id="calc-faq-h" class="text-h2 lg:text-h2-lg mb-4">سؤالات متداول محاسبه قسط</h2>
    <div style="max-width:var(--nf-prose)"><FaqList items={faq} /></div>
  </section>
  <FinalCTA src="calculator" />
</BaseLayout>
