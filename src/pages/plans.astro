---
/** /plans (UX-SPEC §8): finder first, then every active plan in one list (no cash / goods grouping: legal 2026-10-24).
 * v1.2 (design site-seo-pages /plans): ≥1024px a 6-column table (.pt; the rate column was removed, Mohammad 2026-10-28); below that the same cards (.pt-cards). */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PlanFinder from '../components/islands/PlanFinder';
import { ComingSoonCard, PlanCard } from '../components/islands/PlanCard';
import I from '../components/ui/I.astro';
import { fillFaq } from '../lib/faq-fill';
import FaqList from '../components/FaqList.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { getCollection } from 'astro:content';
import { COMING_SOON_SNAPSHOT, LOAN_PLANS_SNAPSHOT } from '../lib/loan-plans.snapshot';
import { COMING_SOON_LABEL } from '../lib/loan-plans';
import { MODE_LABEL, byId, cleanPlanName, combos, fa, millionsFa, planFacts } from '../lib/plans';
import { breadcrumbLd, faqLd } from '../lib/seo';
const facts = planFacts(LOAN_PLANS_SNAPSHOT);
const all = combos(LOAN_PLANS_SNAPSHOT);
const one = [...new Set(all.map((c) => c.id))].map((id) => byId(all, id)!);
// Active plans with no calculable payout (CRM export payout/installment null): listed with «به‌زودی», never a number.
const soon = COMING_SOON_SNAPSHOT.filter((p) => !one.some((c) => c.id === p.id));
// FAQ: the plan questions from home.mdx (count, which plan suits me, amounts/terms) — ANSWERS-1 §9
const home = (await getCollection('pages', (p) => p.data.slug === '/'))[0]!;
const faq = fillFaq(home.data.faq.slice(0, 3), LOAN_PLANS_SNAPSHOT);
const MODE_ICON: Record<string, 'online' | 'pin'> = { both: 'online', online: 'online', in_person: 'pin' };
const crumbs = [
  { name: 'خانه', path: '/' },
  { name: 'طرح‌ها', path: '/plans/' },
];
---

<BaseLayout
  title={`${fa(facts.planCount)} طرح فعال تسهیلات اقساطی`}
  description="همه طرح‌های فعال نفیس وام: مبلغ واریزی، مدت بازپرداخت و زمان بررسی هر طرح؛ با طرح‌یاب ۲ سؤالی."
  jsonLd={[breadcrumbLd(crumbs), faqLd(faq)]}
>
  <PageHeader title={`${fa(facts.planCount)} طرح فعال تسهیلات اقساطی`} lead="لازم نیست همه را بخوانید؛ به ۲ سؤال جواب دهید." crumbs={crumbs} />
  <div class="container-nf pt-8">
    <div class="finder-mount" id="plan-finder">
      <PlanFinder client:load snapshot={LOAN_PLANS_SNAPSHOT} src="plans-finder" />
    </div>
  </div>
  <section class="container-nf pt-section" aria-labelledby="all-h">
    <h2 id="all-h" class="text-h2 lg:text-h2-lg mb-4">همه طرح‌ها</h2>
    <p class="text-ink-muted mb-4">{fa(one.length)} طرح فعال{soon.length > 0 && ` و ${fa(soon.length)} طرح ${COMING_SOON_LABEL}`}؛ مبلغ واریزی و مدت بازپرداخت هر طرح روی کارت آن آمده است.</p>
    <div class="pt not-prose" role="table" aria-label="همه طرح‌ها">
      <div class="pt-h" role="row">
        <span role="columnheader">طرح</span><span role="columnheader">روش</span><span role="columnheader">مبلغ واریزی</span><span role="columnheader">مدت بازپرداخت</span><span role="columnheader"><span class="sr">درخواست</span></span>
      </div>
      {one.map((c) => (
        <div class="pt-r" role="row">
          <b class="pt-nm" role="rowheader">{c.name}{c.retirees && <small>ویژه‌ی بازنشستگان</small>}</b>
          <span role="cell">{MODE_LABEL[c.mode] && <span class={`mode mode--${c.mode}`}><I name={MODE_ICON[c.mode] ?? 'online'} size={18} /><span><span class="sr">روش: </span>{MODE_LABEL[c.mode]}</span></span>}</span>
          <span role="cell"><b class="pt-n">حدود {millionsFa(c.payout)}</b><small>میلیون تومان</small></span>
          <span role="cell"><b class="pt-n">{fa(c.term)}</b><small>ماهه</small></span>
          <span role="cell"><a class="nf-btn nf-btn--secondary pt-go" href={`/request/?plan=${c.id}&term=${c.term}&src=plans-table`}>درخواست این طرح</a></span>
        </div>
      ))}
      {soon.map((p) => (
        <div class="pt-r pt-r--soon" role="row" data-plan-soon={p.id}>
          <b class="pt-nm" role="rowheader">{cleanPlanName(p.name)}{p.retireesOnly && <small>ویژه‌ی بازنشستگان</small>}</b>
          <span role="cell">{MODE_LABEL[p.processMode] && <span class={`mode mode--${p.processMode}`}><I name={MODE_ICON[p.processMode] ?? 'online'} size={18} /><span><span class="sr">روش: </span>{MODE_LABEL[p.processMode]}</span></span>}</span>
          <span role="cell"><b class="pt-n">{COMING_SOON_LABEL}</b></span>
          <span role="cell"><b class="pt-n">{p.terms.map((t) => fa(t)).join('، ')}</b><small>ماهه</small></span>
          <span role="cell"></span>
        </div>
      ))}
    </div>
    <div class="cards plan-list pt-cards">
      {one.map((c) => (
        <PlanCard c={c} src="plans-list" />
      ))}
      {soon.map((p) => (
        <ComingSoonCard p={p} name={cleanPlanName(p.name)} />
      ))}
    </div>
  </section>
  <section class="container-nf pt-section" aria-labelledby="plans-faq-h">
    <h2 id="plans-faq-h" class="text-h2 lg:text-h2-lg mb-4">سؤالات متداول طرح‌ها</h2>
    <div style="max-width:var(--nf-prose)"><FaqList items={faq} /></div>
  </section>
  <FinalCTA src="plans" />
</BaseLayout>
