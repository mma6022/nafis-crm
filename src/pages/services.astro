---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/ui/Icon.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { breadcrumbLd, financialServiceLd } from '../lib/seo';
import { KEYWORD_PAGES } from '../lib/site';
import { LOAN_PLANS_SNAPSHOT } from '../lib/loan-plans.snapshot';
import { fillFacts, planFacts } from '../lib/plans';
const facts = planFacts(LOAN_PLANS_SNAPSHOT);
const crumbs = [
  { name: 'خانه', path: '/' },
  { name: 'خدمات', path: '/services/' },
];
---

<BaseLayout
  title="خدمات نفیس وام؛ وام فوری، بدون ضامن، بدون چک و خرید اقساطی"
  description="همه خدمات نفیس وام در یک صفحه: وام فوری، وام بدون ضامن، وام بدون چک، وام با چک یا سفته و خرید اقساطی با قسط شفاف."
  jsonLd={[breadcrumbLd(crumbs), financialServiceLd()]}
>
  <PageHeader title="خدمات نفیس وام" lead="هر هدف مالی، یک مسیر مناسب دارد." crumbs={crumbs} />
  <div class="container-nf pt-8">
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        KEYWORD_PAGES.map((p) => (
          <li>
            <a href={`/${p.slug}/`} class="hover:border-brand-300 flex min-h-option items-center gap-3 rounded-card border border-line bg-white p-4">
              <span class="bg-brand-50 text-brand-600 grid size-11 shrink-0 place-items-center rounded-xl">
                <Icon name={p.icon} />
              </span>
              <span class="grid flex-1">
                <b class="text-ink">{p.label}</b>
                <span class="text-ink-muted text-caption">
                  {fillFacts(p.blurb, facts)}
                </span>
              </span>
              <Icon name="chev" class="text-ink-faint" />
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-6">
      <a class="nf-btn nf-btn--secondary" href="/plans/#plan-finder">مطمئن نیستید کدام؟ طرح‌یاب ۲ سؤالی <Icon name="chev" /></a>
    </p>
  </div>
  <FinalCTA src="services" />
</BaseLayout>
