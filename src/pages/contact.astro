---
/** Contact (UX-SPEC §7, REVIEW-ADITYA-2 §1): cards + the «درخواست مشاوره‌ی رایگان» callback form (#callback, primary, src=contact-callback); /request?need=help is a text link. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/ui/Icon.astro';
import { buttonClass } from '../components/ui/styles';
import CallbackForm from '../components/islands/CallbackForm';
import { MESSENGERS, PLACEHOLDER_WORK_DAYS, SITE, WORK_HOURS } from '../lib/site';
import { breadcrumbLd } from '../lib/seo';
const crumbs = [
  { name: 'خانه', path: '/' },
  { name: 'تماس با ما', path: '/contact' },
];
const card = 'rounded-card border border-line bg-white p-5';
---

<BaseLayout
  title="تماس با نفیس وام"
  description="راه‌های تماس با نفیس وام: تلفن، واتساپ و ایمیل، یا ثبت درخواست وام در کمتر از یک دقیقه. مشاوره رایگان است."
  jsonLd={[breadcrumbLd(crumbs)]}
>
  <PageHeader title="تماس با ما" lead="یک کارشناس رایگان راهنمایی‌تان می‌کند." crumbs={crumbs} />
  <div class="container-nf grid gap-3 pt-8 sm:grid-cols-2 lg:grid-cols-3">
    <div class={card}>
      <p class="text-ink-muted flex items-center gap-2 text-small"><Icon name="phone" size={18} /> تلفن</p>
      <a href={SITE.tel} class="text-ink mt-1 block text-h2 font-extrabold"><span class="ltr">{SITE.phoneFa}</span></a>
    </div>
    <div class={card}>
      <p class="text-ink-muted flex items-center gap-2 text-small"><Icon name="wa" size={18} /> پیام‌رسان‌ها</p>
      <div class="mt-2 flex flex-wrap gap-2">
        {
          Object.values(MESSENGERS).map((m) => (
            <a href={m.href} data-todo="messenger-link" class={buttonClass('secondary', 'sm')}>
              {m.label}
            </a>
          ))
        }
      </div>
      <p class="mt-2"><span class="ph">[جای‌خالی: لینک‌ها از محمد]</span></p>
    </div>
    <div class={card}>
      <p class="text-ink-muted text-small">ایمیل</p>
      <a href={`mailto:${SITE.email}`} class="text-ink mt-1 block font-extrabold break-all"><span class="ltr">{SITE.email}</span></a>
      <p class="mt-1"><span class="ph">[تأیید محمد]</span></p>
    </div>
    <div class={card}>
      <p class="text-ink-muted flex items-center gap-2 text-small"><Icon name="pin" size={18} /> ساعت کاری و آدرس</p>
      <p class="text-ink mt-2 font-extrabold">ساعت کاری: {WORK_HOURS.fa}</p>
      <p class="mt-1"><span class="ph">{PLACEHOLDER_WORK_DAYS}</span></p>
      <p class="mt-1"><span class="ph">[جای‌خالی: آدرس]</span></p>
    </div>
    <div class={card}>
      <p class="text-ink-muted flex items-center gap-2 text-small"><Icon name="user" size={18} /> مشتری هستید؟</p>
      <a href={SITE.portal} class={buttonClass('secondary', 'md', 'mt-2 w-full')}>ورود مشتریان</a>
    </div>
    <section class="sm:col-span-2 lg:col-span-3 pt-4" id="callback" aria-label="درخواست مشاوره‌ی رایگان">
      <CallbackForm client:visible variant="section" src="contact-callback" />
      <p class="text-small text-ink-muted mt-3">
        ترجیح می‌دهید مستقیم درخواست وام ثبت کنید؟ <a class="text-brand-700 font-semibold underline" href="/request?need=help&src=contact">ثبت درخواست وام</a>
      </p>
    </section>
  </div>
</BaseLayout>
