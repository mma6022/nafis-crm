---
/**
 * Contact (UX-SPEC §7, REVIEW-ADITYA-2 §1): landline + «کارشناسان فروش» (Mohammad 2026-10-23: three sales experts, each with
 * a ≥48px call button and WhatsApp / Telegram / Bale icon links — mobiles ONLY here, never in header/footer/schema),
 * email, hours, Instagram, portal + the «درخواست مشاوره‌ی رایگان» callback form (#callback, src=contact-callback).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/ui/Icon.astro';
import I from '../components/ui/I.astro';
import { buttonClass } from '../components/ui/styles';
import CallbackForm from '../components/islands/CallbackForm';
import { SALES_EXPERTS, SITE, SOCIAL, WORK_HOURS, expertLinks } from '../lib/site';
import { faMobile } from '../lib/callback';
import { breadcrumbLd } from '../lib/seo';
const crumbs = [
  { name: 'خانه', path: '/' },
  { name: 'تماس با ما', path: '/contact' },
];
const card = 'rounded-card border border-line bg-white p-5';
const experts = SALES_EXPERTS.map((e) => ({ ...e, fa: faMobile(e.mobile), l: expertLinks(e.mobile) }));
---

<BaseLayout
  title="تماس با نفیس وام"
  description="راه‌های تماس با نفیس وام: تلفن ثابت، کارشناسان فروش (تماس، واتساپ، تلگرام و بله) و ایمیل، یا ثبت درخواست مشاوره‌ی رایگان."
  jsonLd={[breadcrumbLd(crumbs)]}
>
  <PageHeader title="تماس با ما" lead="یک کارشناس رایگان راهنمایی‌تان می‌کند." crumbs={crumbs} />
  <div class="container-nf grid gap-3 pt-8 sm:grid-cols-2 lg:grid-cols-3">
    <div class={`${card} sm:col-span-2 lg:col-span-3`}>
      <p class="text-ink-muted flex items-center gap-2 text-small"><Icon name="phone" size={18} /> تلفن ثابت</p>
      <a href={SITE.tel} class="text-ink mt-1 block text-h2 font-extrabold"><span class="ltr">{SITE.phoneFa}</span></a>
      <section class="experts" id="experts" aria-labelledby="experts-h">
        <h2 id="experts-h">کارشناسان فروش</h2>
        <p class="experts-hours"><I name="clock" size={18} /> {WORK_HOURS.shortFa}</p>
        <ul>
          {
            experts.map((e) => (
              <li class="expert">
                <span class="expert-name">{e.name}</span>
                <div class="expert-actions">
                  <a class="nf-btn nf-btn--secondary expert-call" href={e.l.tel} aria-label={`تماس با ${e.name}`}>
                    <I name="phone" size={18} /> <span dir="ltr">{e.fa}</span>
                  </a>
                  <a class="expert-msg" href={e.l.whatsapp} target="_blank" rel="noopener" aria-label={`واتساپ ${e.name}`}><I name="wa" class="wa" /></a>
                  <a class="expert-msg" href={e.l.telegram} target="_blank" rel="noopener" aria-label={`تلگرام ${e.name}`}><I name="tg" /></a>
                  <a class="expert-msg" href={e.l.bale} target="_blank" rel="noopener" aria-label={`بله ${e.name}`}><I name="bale" /></a>
                </div>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
    <div class={card}>
      <p class="text-ink-muted text-small">ایمیل</p>
      <a href={`mailto:${SITE.email}`} class="text-ink mt-1 block font-extrabold break-all"><span class="ltr">{SITE.email}</span></a>
    </div>
    <div class={card}>
      <p class="text-ink-muted flex items-center gap-2 text-small"><Icon name="clock" size={18} /> ساعت کاری</p>
      <p class="text-ink mt-2 font-extrabold">{WORK_HOURS.daysFa}، {WORK_HOURS.fa}</p>
      <p class="text-ink-muted mt-1 text-small">جمعه و تعطیلات رسمی تعطیل است.</p>
    </div>
    <div class={card}>
      <p class="text-ink-muted flex items-center gap-2 text-small"><I name="ig" size={18} /> اینستاگرام</p>
      <a href={SOCIAL.instagram.href} target="_blank" rel="noopener" class="text-ink mt-1 block font-extrabold"><span class="ltr">@{SOCIAL.instagram.handle}</span></a>
    </div>
    <div class={card}>
      <p class="text-ink-muted flex items-center gap-2 text-small"><Icon name="user" size={18} /> مشتری هستید؟</p>
      <a href={SITE.portal} class={buttonClass('secondary', 'md', 'mt-2 w-full')}>ورود مشتریان</a>
    </div>
    <div class={card}>
      <p class="text-ink-muted text-small">نام حقوقی</p>
      <p class="text-ink mt-1 font-extrabold">{SITE.legalName}</p>
      <p class="text-ink-muted mt-1 text-small">شناسه ملی <span class="ltr">{SITE.nationalIdFa}</span></p>
    </div>
    <section class="sm:col-span-2 lg:col-span-3 pt-4" id="callback" aria-label="درخواست مشاوره‌ی رایگان">
      <CallbackForm client:visible variant="section" src="contact-callback" />
      <p class="text-small text-ink-muted mt-3">
        ترجیح می‌دهید مستقیم درخواست وام ثبت کنید؟ <a class="text-brand-700 font-semibold underline" href="/request?need=help&src=contact">ثبت درخواست وام</a>
      </p>
    </section>
  </div>
</BaseLayout>
