---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { fa } from '../lib/plans';
import { breadcrumbLd } from '../lib/seo';
const crumbs = [
  { name: 'خانه', path: '/' },
  { name: 'مراحل دریافت', path: '/how-it-works' },
];
const steps = [
  { t: 'طرح مناسب را پیدا کنید', d: 'به ۳ سؤال طرح‌یاب جواب دهید یا مستقیم درخواست بدهید. مبلغ قابل دریافت و قسط هر طرح را از قبل می‌بینید.' },
  { t: 'کارشناس با شما تماس می‌گیرد', d: 'شرایط طرح، ضمانت لازم و مدارک را توضیح می‌دهد. مشاوره رایگان است و تعهدی ایجاد نمی‌کند.' },
  { t: 'مدارک و اعتبارسنجی', d: 'مدارک را آنلاین یا حضوری تحویل می‌دهید. اعتبارسنجی بانکی انجام می‌شود و مبلغ قطعی اعلام می‌شود.' },
  { t: 'واریز یا تحویل کالا', d: 'پس از امضای قرارداد، تسهیلات واریز می‌شود یا کالا تحویل داده می‌شود. وضعیت پرونده را در پرتال مشتریان می‌بینید.' },
];
---

<BaseLayout
  title="مراحل دریافت وام در نفیس وام"
  description="از انتخاب طرح تا واریز وام در ۴ قدم: طرح‌یاب، تماس کارشناس، مدارک و اعتبارسنجی، واریز یا تحویل کالا. شفاف و بدون غافلگیری."
  jsonLd={[breadcrumbLd(crumbs)]}
>
  <PageHeader title="از درخواست تا دریافت، در ۴ قدم" lead="همه شرایط را قبل از امضا می‌دانید." crumbs={crumbs} />
  <ol class="container-nf grid gap-3 pt-8 lg:grid-cols-2">
    {
      steps.map((s, i) => (
        <li class="flex gap-4 rounded-card border border-line bg-white p-5">
          <span class="bg-brand-600 grid size-10 shrink-0 place-items-center rounded-full font-extrabold text-white">{fa(i + 1)}</span>
          <div>
            <h2 class="text-h3">{s.t}</h2>
            <p class="text-ink-muted mt-1 text-small">{s.d}</p>
          </div>
        </li>
      ))
    }
  </ol>
  <p class="container-nf text-ink-muted mt-4 text-caption">زمان بررسی هر طرح روی کارت آن نوشته شده است. [تأیید محمد: متن مراحل]</p>
  <FinalCTA src="how-it-works" />
</BaseLayout>
