---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { fa } from '../lib/plans';
import { GRANT_DAYS_LABEL } from '../lib/loan-plans';
import { LOAN_PLANS_SNAPSHOT } from '../lib/loan-plans.snapshot';
import { breadcrumbLd } from '../lib/seo';
const crumbs = [
  { name: 'خانه', path: '/' },
  { name: 'مراحل دریافت', path: '/how-it-works/' },
];
// Review times straight from the plan JSON (ANSWERS-1 §9): «کمتر از ۷ روز (۲ طرح)، ۱۰ تا ۱۵ روز (۱۶ طرح)»
const times = Object.entries(
  LOAN_PLANS_SNAPSHOT.reduce<Record<string, number>>((m, p) => ((m[p.grantDays] = (m[p.grantDays] ?? 0) + 1), m), {}),
)
  .sort(([a], [b]) => Object.keys(GRANT_DAYS_LABEL).indexOf(a) - Object.keys(GRANT_DAYS_LABEL).indexOf(b))
  .map(([k, n]) => `${GRANT_DAYS_LABEL[k] ?? k} (${fa(n)} طرح)`)
  .join('، ');
const steps = [
  { t: 'طرح مناسب را پیدا کنید', d: 'به ۲ سؤال طرح‌یاب جواب دهید یا مستقیم درخواست بدهید. مبلغ واریزی و قسط هر طرح را از قبل می‌بینید.' },
  { t: 'کارشناس با شما تماس می‌گیرد', d: 'شرایط طرح، ضمانت لازم و مدارک را توضیح می‌دهد. مشاوره رایگان است و تعهدی ایجاد نمی‌کند.' },
  {
    t: 'مدارک و اعتبارسنجی',
    d: 'مدارک را آنلاین یا حضوری تحویل می‌دهید. مبلغ قطعی را بانک یا تأمین‌کننده‌ی مالی پس از اعتبارسنجی تعیین می‌کند.',
    time: `زمان بررسی: ${times}`,
    docs: true,
  },
  { t: 'پرداخت تسهیلات', d: 'پس از امضای قرارداد، تسهیلات طبق شرایط طرح پرداخت می‌شود. وضعیت پرونده را در پورتال مشتریان می‌بینید.' },
];
---

<BaseLayout
  title="مراحل دریافت وام در نفیس وام"
  description="از انتخاب طرح تا واریز وام در ۴ قدم: طرح‌یاب، تماس کارشناس، مدارک و اعتبارسنجی، پرداخت تسهیلات. شفاف و بدون غافلگیری."
  jsonLd={[breadcrumbLd(crumbs)]}
>
  <PageHeader title="از درخواست تا دریافت، در ۴ قدم" lead="همه شرایط را قبل از امضا می‌دانید." crumbs={crumbs} />
  <div class="container-nf pt-8">
    <ol class="hiw-steps">
      {
        steps.map((s, i) => (
          <li>
            <span class="n" aria-hidden="true">{fa(i + 1)}</span>
            <div>
              <h2>{s.t}</h2>
              <p>{s.d}</p>
              {'time' in s && <p class="time">{s.time}</p>}
              {'docs' in s && (
                <p class="docs">
                  فهرست دقیق مدارک هر طرح را کارشناس در تماس به شما می‌گوید تا چیزی را بی‌دلیل آماده نکنید.
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
    <p class="text-ink-muted mt-4 text-caption">بررسی بیشتر طرح‌ها ۱۰ تا ۱۵ روز و در طرح‌های سریع کمتر از ۷ روز طول می‌کشد.</p>
    <p class="mt-6"><a class="nf-btn nf-btn--primary" href="/request/?src=how-it-works">ثبت درخواست</a></p>
  </div>
  <FinalCTA src="how-it-works" />
</BaseLayout>
