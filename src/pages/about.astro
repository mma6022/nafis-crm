---
/** /about (UX-SPEC §7, ANSWERS-1 §9): lead, mission, confirmed stats (TRUST_STATS), legal entity + national ID, «تماس با کارشناس» (expert picker; landline removed 2026-10-23) and hours (Mohammad 2026-10-23), FinalCTA. Address (PM decision) + no map: none has been given. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { LOAN_PLANS_SNAPSHOT } from '../lib/loan-plans.snapshot';
import { fa, planFacts } from '../lib/plans';
import { breadcrumbLd } from '../lib/seo';
import { SITE, SOCIAL, TRUST_STATS, WORK_HOURS } from '../lib/site';
import { pickerTrigger } from '../data/experts';
const crumbs = [
  { name: 'خانه', path: '/' },
  { name: 'درباره ما', path: '/about' },
];
const facts = planFacts(LOAN_PLANS_SNAPSHOT);
---

<BaseLayout
  title="درباره نفیس وام"
  description="نفیس وام کیست و چطور به شما کمک می‌کند تا آگاهانه و شفاف، تسهیلات و وام متناسب با شرایط خود را انتخاب کنید."
  jsonLd={[breadcrumbLd(crumbs)]}
>
  <PageHeader title="درباره نفیس وام" lead="کمک می‌کنیم از بین طرح‌های فعال، طرحی را انتخاب کنید که واقعاً به کارتان می‌آید." crumbs={crumbs} />
  <div class="container-nf pt-8 about">
    <section class="mission" aria-labelledby="mission-h">
      <p class="eyebrow">مأموریت ما</p>
      <h2 id="mission-h">برای هر مشتری یک طرح مناسب و شفاف</h2>
      <p>
        مبلغ قابل دریافت، قسط ماهانه و زمان بررسی هر کدام از <span data-plan-count="planCount">{fa(facts.planCount)}</span> طرح فعال را قبل از درخواست
        نشان می‌دهیم تا بدون غافلگیری تصمیم بگیرید.
      </p>
    </section>
    <ul class="about-stats" aria-label="نفیس وام در یک نگاه">
      {TRUST_STATS.map((t) => <li>{t.pre} <b>{t.b}</b> {t.post}</li>)}
    </ul>
    <section class="about-facts" aria-labelledby="facts-h">
      <h2 id="facts-h">مشخصات نفیس وام</h2>
      <dl>
        <div><dt>نام حقوقی</dt><dd>{SITE.legalName}</dd></div>
        <div><dt>شناسه ملی</dt><dd><span class="ltr">{SITE.nationalIdFa}</span></dd></div>
        <div><dt>نشانی</dt><dd><address class="not-italic" data-address>{SITE.address}</address></dd></div>
        <div><dt>تماس</dt><dd><a {...pickerTrigger('call')}>تماس با کارشناس</a></dd></div>
        <div><dt>ساعت کاری</dt><dd>{WORK_HOURS.daysFa}، {WORK_HOURS.fa}</dd></div>
        <div><dt>اینستاگرام</dt><dd><a href={SOCIAL.instagram.href} target="_blank" rel="noopener"><span class="ltr">@{SOCIAL.instagram.handle}</span></a></dd></div>
      </dl>
      <p class="about-more">کارشناسان فروش و راه‌های پیام‌رسان در صفحه‌ی <a href="/contact/#experts">تماس با ما</a>.</p>
    </section>
    <p class="mt-6"><a class="nf-btn nf-btn--primary" href="/request?src=about">ثبت درخواست</a></p>
  </div>
  <FinalCTA src="about" />
</BaseLayout>
