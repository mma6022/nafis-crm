---
/**
 * Keyword landing (designer mockup vam-fori.html): `.lp-hero` (crumbs, live badge, H1, lead = first MDX paragraph,
 * mobile actions) + `.lp-grid` (article + desktop sticky aside: CTA card and «در این صفحه»). FAQPage + Breadcrumb JSON-LD.
 */
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import I from '../components/ui/I.astro';
import RequestCTA from '../components/RequestCTA.astro';
import { mdxComponents } from '../components/mdx';
import { LOAN_PLANS_SNAPSHOT } from '../lib/loan-plans.snapshot';
import { fa, fillFacts, leadHtml, planFacts, planFilter } from '../lib/plans';
import { breadcrumbLd, faqLd } from '../lib/seo';
import { fillFaq } from '../lib/faq-fill';
interface Props {
  entry: CollectionEntry<'pages'>;
}
const { entry } = Astro.props;
const d = entry.data;
const facts = planFacts(LOAN_PLANS_SNAPSHOT);
const fill = (s: string) => fillFacts(s, facts);
const faq = fillFaq(d.faq, LOAN_PLANS_SNAPSHOT);
Astro.locals.faq = faq;
const { Content, headings } = await render(entry);
Astro.locals.headings = headings;
const page = d.slug.replace(/^\//, '');
const lead = d.lead ? leadHtml(d.lead, facts) : '';
/** callback section lead per page (title stays «درخواست مشاوره‌ی رایگان»; designer vam-fori mockup) */
const CB_LEAD: Record<string, string> = {
  'vam-fori': 'نام و شماره‌تان را بگذارید؛ کارشناس نفیس وام تماس می‌گیرد و سریع‌ترین طرح متناسب با شما را توضیح می‌دهد.',
  'vam-bedun-zamen': 'نام و شماره‌تان را بگذارید؛ کارشناس نفیس وام طرح‌های بدون ضامن را رایگان برایتان توضیح می‌دهد.',
  'vam-bedun-chek': 'نام و شماره‌تان را بگذارید؛ کارشناس نفیس وام طرح‌های بدون چک را رایگان برایتان توضیح می‌دهد.',
  'vam-ba-chek': 'نام و شماره‌تان را بگذارید؛ کارشناس نفیس وام طرح‌های با ضمانت چک را رایگان برایتان توضیح می‌دهد.',
  'vam-ba-safte': 'نام و شماره‌تان را بگذارید؛ کارشناس نفیس وام طرح‌های با ضمانت سفته را رایگان برایتان توضیح می‌دهد.',
  'kharid-aghsati': 'نام و شماره‌تان را بگذارید؛ کارشناس نفیس وام طرح‌های متناسب با مبلغ و شرایط شما را رایگان برایتان توضیح می‌دهد.',
  'vam-ani': 'نام و شماره‌تان را بگذارید؛ کارشناس نفیس وام تماس می‌گیرد و مسیر درخواست آنلاین را رایگان برایتان توضیح می‌دهد.',
  'vam-fori-bedun-chek': 'نام و شماره‌تان را بگذارید؛ کارشناس نفیس وام سریع‌ترین طرح‌های بدون چک را رایگان برایتان توضیح می‌دهد.',
  'vam-fori-bedun-zamen': 'نام و شماره‌تان را بگذارید؛ کارشناس نفیس وام سریع‌ترین طرح‌های بدون ضامن را رایگان برایتان توضیح می‌دهد.',
};
const cbLead = CB_LEAD[page];
const toc = headings.filter((h) => h.depth === 2);
const crumbs = [
  { name: 'خانه', path: '/' },
  { name: 'خدمات', path: '/services/' },
  { name: d.primaryKeyword, path: d.slug },
];
/**
 * Live badge (designer ANSWERS-1 §7): count of plans that truly meet the page's condition (guarantee pages use the
 * strict rules of data/plan-guarantees.ts, the same list <GuaranteePlans> renders). Zero → no badge.
 */
const BADGE: Record<string, { filter: string; key: 'fastCount' | 'planCount' | null; text: string; tone: string }> = {
  'vam-fori': { filter: 'fast', key: 'fastCount', text: 'طرح فعال با بررسی کمتر از ۷ روز', tone: 'success' },
  'kharid-aghsati': { filter: 'all', key: 'planCount', text: 'طرح فعال تسهیلات اقساطی', tone: 'brand' },
  'vam-bedun-zamen': { filter: 'noGuarantor', key: null, text: 'طرح فعال بدون ضامن', tone: 'brand' },
  'vam-bedun-chek': { filter: 'noCheque', key: null, text: 'طرح فعال بدون چک', tone: 'brand' },
  'vam-ba-chek': { filter: 'cheque', key: null, text: 'طرح فعال با چک', tone: 'brand' },
  'vam-ba-safte': { filter: 'promissory', key: null, text: 'طرح فعال با سفته', tone: 'brand' },
  /** A1: plans that can run without an in-person visit (processMode both|online). A2/A3 deliberately have no badge. */
  'vam-ani': { filter: 'online', key: null, text: 'طرح فعال با امکان پیشبرد بدون مراجعه حضوری', tone: 'brand' },
};
const badgeDef = BADGE[page];
const badgeFn = badgeDef ? planFilter(badgeDef.filter, LOAN_PLANS_SNAPSHOT) : null;
const badgeN = badgeFn ? new Set(LOAN_PLANS_SNAPSHOT.filter(badgeFn).map((p) => p.id)).size : 0;
const badge = badgeDef && badgeFn && badgeN > 0 ? { ...badgeDef, n: badgeN } : null;
/** Side panel (ANSWERS-1 §7): never a guarantee claim; only the frontmatter cta.primary (no call / messenger button: HANDOFF §0 v1.2). */
const ASIDE: Record<string, { h?: string; p: string }> = {
  'vam-fori': { p: 'درخواست ثبت کنید؛ کارشناس سریع‌ترین طرح متناسب با شما را پیشنهاد می‌دهد.' },
  'kharid-aghsati': { h: 'قصد خرید اقساطی دارید؟', p: 'درخواست ثبت کنید؛ کارشناس طرح متناسب با مبلغ و مدت بازپرداخت دلخواه شما را پیشنهاد می‌دهد.' },
  'vam-ani': { h: 'می‌خواهید آنلاین شروع کنید؟', p: 'درخواست را از گوشی ثبت کنید؛ کارشناس در ساعت کاری، پس از ثبت درخواست تماس می‌گیرد.' },
  'vam-fori-bedun-chek': { h: 'دسته‌چک ندارید و عجله دارید؟', p: 'درخواست ثبت کنید؛ کارشناس سریع‌ترین طرح بدون چک متناسب با شما را پیشنهاد می‌دهد.' },
  'vam-fori-bedun-zamen': { h: 'ضامن ندارید و عجله دارید؟', p: 'درخواست ثبت کنید؛ کارشناس سریع‌ترین طرح بدون ضامن متناسب با شما را پیشنهاد می‌دهد.' },
};
const aside = { h: ASIDE[page]?.h ?? `${d.primaryKeyword} لازم دارید؟`, p: ASIDE[page]?.p ?? 'درخواست ثبت کنید؛ کارشناس مناسب‌ترین طرح را با شما مرور می‌کند.' };
/** HANDOFF §0 v1.2: no call / picker entry point anywhere — a cta.secondary that pointed to the old /contact/#experts
 *  picker is never rendered (the pages no longer have one; this guards stale frontmatter). */
const isTel = (h: string) => /^\/contact\/?#experts/.test(h) || /^(tel|sms):/.test(h);
const secondary = d.cta.secondary && !isTel(d.cta.secondary.href) ? d.cta.secondary : null;
---

<BaseLayout rawTitle title={fill(d.title)} description={fill(d.description)} canonicalPath={d.slug} src={page} jsonLd={[faqLd(faq), breadcrumbLd(crumbs)]}>
  <section class="lp-hero">
    <div class="container-nf">
      <Breadcrumbs items={crumbs} />
      {
        badge && (
          <span class={`nf-badge nf-badge--${badge.tone}`}>
            {badge.key ? <span data-plan-count={badge.key}>{fa(badge.n)}</span> : fa(badge.n)} {badge.text}
          </span>
        )
      }
      <h1>{fill(d.h1)}</h1>
      {lead && <p class="lead" set:html={lead} />}
      <div class="actions">
        <a class="nf-btn nf-btn--primary nf-btn--block" href={d.cta.primary.href}>{d.cta.primary.text} <I name="arrow" /></a>
        {secondary && <a class="nf-btn nf-btn--text" href={secondary.href}>{secondary.text}</a>}
      </div>
    </div>
  </section>
  <div class="container-nf lp-grid">
    <article class="prose-nf" style="max-width:none">
      <Content components={mdxComponents} />
    </article>
    <aside class="aside" aria-label="درخواست سریع">
      <div class="nf-card aside-card">
        <h2>{aside.h}</h2>
        <p>{aside.p}</p>
        <a class="nf-btn nf-btn--primary nf-btn--block" href={d.cta.primary.href}>{d.cta.primary.text}</a>
      </div>
      {
        toc.length > 1 && (
          <nav class="nf-card aside-card toc" aria-label="در این صفحه">
            <h2>در این صفحه</h2>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </aside>
  </div>
  <section class="cb-sec cb-sec--end" id="callback" aria-label="مشاوره‌ی رایگان">
    <div class="container-nf"><RequestCTA primary={false} src={`${page}-callback`} lead={cbLead} /></div>
  </section>
</BaseLayout>
