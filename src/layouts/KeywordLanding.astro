---
/**
 * Keyword landing (designer mockup vam-fori.html): `.lp-hero` (crumbs, live badge, H1, lead = first MDX paragraph,
 * mobile actions) + `.lp-grid` (article + desktop sticky aside: CTA card and «در این صفحه»). FAQPage + Breadcrumb JSON-LD.
 */
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import I from '../components/ui/I.astro';
import { mdxComponents } from '../components/mdx';
import { LOAN_PLANS_SNAPSHOT } from '../lib/loan-plans.snapshot';
import { fa, fillFacts, leadHtml, planFacts } from '../lib/plans';
import { breadcrumbLd, faqLd } from '../lib/seo';
import { MESSENGERS, SITE } from '../lib/site';
interface Props {
  entry: CollectionEntry<'pages'>;
}
const { entry } = Astro.props;
const d = entry.data;
const facts = planFacts(LOAN_PLANS_SNAPSHOT);
const fill = (s: string) => fillFacts(s, facts);
const faq = d.faq.map((f) => ({ q: fill(f.q), a: fill(f.a) }));
Astro.locals.faq = faq;
const { Content, headings } = await render(entry);
Astro.locals.headings = headings;
const page = d.slug.replace(/^\//, '');
const lead = d.lead ? leadHtml(d.lead, facts) : '';
const toc = headings.filter((h) => h.depth === 2);
const crumbs = [
  { name: 'خانه', path: '/' },
  { name: 'خدمات', path: '/services' },
  { name: d.primaryKeyword, path: d.slug },
];
/** Live badge per page (mockup only specifies /vam-fori). */
const BADGE: Record<string, { key: 'fastCount' | 'goodsCount'; text: string; tone: string }> = {
  'vam-fori': { key: 'fastCount', text: 'طرح فعال با بررسی کمتر از ۷ روز', tone: 'success' },
  'kharid-aghsati': { key: 'goodsCount', text: 'طرح فعال خرید اقساطی', tone: 'brand' },
};
const badge = BADGE[page];
const ASIDE: Record<string, string> = {
  'vam-fori': 'درخواست ثبت کنید؛ کارشناس سریع‌ترین طرح متناسب با شما را پیشنهاد می‌دهد.',
};
const asideText = ASIDE[page] ?? 'درخواست ثبت کنید؛ کارشناس مناسب‌ترین طرح را با شما مرور می‌کند.';
const isTel = (h: string) => h.startsWith('tel:');
---

<BaseLayout rawTitle title={fill(d.title)} description={fill(d.description)} canonicalPath={d.slug} src={page} jsonLd={[faqLd(faq), breadcrumbLd(crumbs)]}>
  <section class="lp-hero">
    <div class="container-nf">
      <Breadcrumbs items={crumbs} />
      {
        badge && (
          <span class={`nf-badge nf-badge--${badge.tone}`}>
            <span data-plan-count={badge.key}>{fa(facts[badge.key])}</span> {badge.text}
          </span>
        )
      }
      <h1>{fill(d.h1)}</h1>
      {lead && <p class="lead" set:html={lead} />}
      <div class="actions">
        <a class="nf-btn nf-btn--primary nf-btn--block" href={d.cta.primary.href}>{d.cta.primary.text} <I name="arrow" /></a>
        {
          d.cta.secondary && (
            <a class="nf-btn nf-btn--text" href={d.cta.secondary.href}>
              {isTel(d.cta.secondary.href) && <I name="phone" size={18} />} {d.cta.secondary.text}
            </a>
          )
        }
      </div>
    </div>
  </section>
  <div class="container-nf lp-grid">
    <article class="prose-nf" style="max-width:none">
      <Content components={mdxComponents} />
    </article>
    <aside class="aside" aria-label="درخواست سریع">
      <div class="nf-card aside-card">
        <h2>{d.primaryKeyword} لازم دارید؟</h2>
        <p>{asideText}</p>
        <a class="nf-btn nf-btn--primary nf-btn--block" href={d.cta.primary.href}>{d.cta.primary.text}</a>
        <div class="row">
          <a class="nf-btn nf-btn--secondary" href={SITE.tel}><I name="phone" size={18} /> تماس</a>
          <a class="nf-btn nf-btn--secondary" href={MESSENGERS.whatsapp.href} data-todo="whatsapp"><I name="wa" size={20} class="wa" /> واتساپ</a>
        </div>
      </div>
      {
        toc.length > 1 && (
          <nav class="nf-card aside-card toc" aria-label="در این صفحه">
            <h2>در این صفحه</h2>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </aside>
  </div>
</BaseLayout>
