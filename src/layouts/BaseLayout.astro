---
import IconSprite from '../components/IconSprite.astro';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE, absoluteUrl, jalaliYear } from '../lib/site';
import { organizationLd, websiteLd } from '../lib/seo';

export interface Props {
  title: string; // page title WITHOUT brand suffix (home passes the full title + `rawTitle`)
  description: string;
  rawTitle?: boolean;
  image?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  canonicalPath?: string; // defaults to the current path
  jsonLd?: unknown[];
  publishedTime?: Date;
  modifiedTime?: Date;
  /** lead `src` prefix for header/sticky CTAs, e.g. "home" → ?src=home-header (defaults to the first path segment) */
  src?: string;
  /** /request hides the sticky mobile CTA bar (UX-SPEC §3) */
  hideStickyBar?: boolean;
  /** /request: logo + phone header, one-line footer (mockup request.html) */
  minimal?: boolean;
}
const {
  title,
  description,
  rawTitle = false,
  image = SITE.ogImage,
  ogType = 'website',
  noindex = false,
  jsonLd = [],
  publishedTime,
  modifiedTime,
  hideStickyBar = false,
  minimal = false,
} = Astro.props;
const fullTitle = rawTitle ? title : `${title} | ${SITE.name}`;
const path = Astro.props.canonicalPath ?? Astro.url.pathname;
const canonical = absoluteUrl(path === '/' ? '/' : path.replace(/\/$/, ''));
const ogImage = absoluteUrl(image);
const src = Astro.props.src ?? (path.split('/').filter(Boolean)[0] || 'home');
---

<!doctype html>
<html lang="fa-IR" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#0B1450" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`مجله ${SITE.name}`} href={absoluteUrl('/rss.xml')} />

    <JsonLd data={[organizationLd(), websiteLd(), ...jsonLd]} />
    <slot name="head" />
  </head>
  <body class:list={[hideStickyBar && 'no-bar']}>
    <IconSprite />
    <Header src={src} minimal={minimal} />
    <main id="main" class={minimal ? 'rq' : undefined}>
      <slot />
    </main>
    {
      minimal ? (
        <footer class="container-nf rq-foot">
          © {jalaliYear()} {SITE.name} · <a href="/privacy">حریم خصوصی</a>
        </footer>
      ) : (
        <Footer />
      )
    }
    {!hideStickyBar && <StickyBar src={src} />}
    <script>
      import { captureUtm, refreshLiveFacts } from '../scripts/live-facts';
      import { initChrome } from '../scripts/chrome';
      initChrome();
      captureUtm();
      const run = () => void refreshLiveFacts();
      if ('requestIdleCallback' in window) requestIdleCallback(run);
      else setTimeout(run, 1);
    </script>
  </body>
</html>
