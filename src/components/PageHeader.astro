---
/**
 * Page header for pages without a mockup (designer ANSWERS-1 §9 common pattern): `.lp-hero` with breadcrumb,
 * H1 and a one-line lead. Being `.lp-hero` it is also the header-button trigger (§8, src/scripts/chrome.ts).
 */
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '../lib/seo';
interface Props {
  title: string;
  lead?: string;
  crumbs?: Crumb[];
}
const { title, lead, crumbs } = Astro.props;
---

<section class="lp-hero page-hero">
  <div class="container-nf">
    {crumbs && <Breadcrumbs items={crumbs} />}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
