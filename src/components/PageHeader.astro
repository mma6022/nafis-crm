---
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '../lib/seo';
interface Props {
  title: string;
  lead?: string;
  crumbs?: Crumb[];
}
const { title, lead, crumbs } = Astro.props;
---

<div class="border-b border-line bg-white">
  <div class="container-nf py-8 sm:py-12">
    {crumbs && <Breadcrumbs items={crumbs} />}
    <h1 class="text-[28px] leading-snug font-extrabold sm:text-4xl">{title}</h1>
    {lead && <p class="mt-3 max-w-2xl text-base text-ink-muted sm:text-lg">{lead}</p>}
    <slot />
  </div>
</div>
