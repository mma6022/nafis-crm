---
/**
 * Logo: final vector by Omid (/workspace/nafis-design/logo, 2026-10-23): body #29369B, wave #00006D.
 * `white` = nafis-logo-white.svg for dark backgrounds (footer). viewBox 0 0 3304 600; size it by WIDTH in CSS
 * (header 154px mobile / 175px desktop, height:auto). Never stretch.
 */
import { SITE } from '../lib/site';
interface Props {
  /** intrinsic width attribute (CSS sets the rendered width) */
  width?: number;
  class?: string;
  white?: boolean;
  /** header logo only: above the fold */
  eager?: boolean;
}
const RATIO = 3304 / 600;
const { width = 175, class: cls = '', white = false, eager = false } = Astro.props;
const height = Math.round(width / RATIO);
---

<img
  src={white ? '/logo/nafis-logo-white.svg' : '/logo/nafis-logo-full.svg'}
  alt={SITE.name}
  width={width}
  height={height}
  class={cls || undefined}
  decoding="async"
  fetchpriority={eager ? 'high' : undefined}
  loading={eager ? undefined : 'lazy'}
/>
