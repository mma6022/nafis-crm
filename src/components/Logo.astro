---
/**
 * Logo: flat vector from /workspace/nafis-design/brand/ (auto-traced from the official raster; no original vector
 * exists, see brand/README.md). `navy` = #0B1450 variant for light/gold backgrounds.
 * The SVG viewBox is cropped to the exact path box (12.8 13.25 1375.6 251.1, designer ANSWERS-1 §2); size it by
 * WIDTH in CSS (header 154px mobile / 175px desktop, height:auto). Never stretch (no preserveAspectRatio=none).
 */
import { SITE } from '../lib/site';
interface Props {
  /** intrinsic width attribute (CSS sets the rendered width) */
  width?: number;
  class?: string;
  navy?: boolean;
}
const RATIO = 1375.6 / 251.1;
const { width = 175, class: cls = '', navy = false } = Astro.props;
const height = Math.round(width / RATIO);
---

<img
  src={navy ? '/brand/nafis-logo-navy.svg' : '/brand/nafis-logo.svg'}
  alt={SITE.name}
  width={width}
  height={height}
  class={cls || undefined}
  decoding="async"
  fetchpriority="high"
/>
