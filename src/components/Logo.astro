---
/**
 * Logo: flat vector from /workspace/nafis-design/brand/ (auto-traced from the official raster; no original vector
 * exists, see brand/README.md). `navy` = #0B1450 variant for light/gold backgrounds.
 */
import { SITE } from '../lib/site';
interface Props {
  height?: number;
  class?: string;
  navy?: boolean;
}
const { height = 30, class: cls = '', navy = false } = Astro.props;
const width = Math.round((1400 / 289) * height);
---

<img
  src={navy ? '/brand/nafis-logo-navy.svg' : '/brand/nafis-logo.svg'}
  alt={SITE.name}
  width={width}
  height={height}
  class={cls || undefined}
  decoding="async"
  fetchpriority="high"
/>
