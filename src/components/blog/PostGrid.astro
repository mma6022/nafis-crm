---
import PostCard from './PostCard.astro';
import type { Post } from '../../lib/blog';
interface Props {
  posts: Post[];
}
---

{
  Astro.props.posts.length === 0 ? (
    <p class="text-ink-muted">هنوز مطلبی منتشر نشده است.</p>
  ) : (
    <div class="posts">
      {Astro.props.posts.map((p) => (
        <PostCard post={p} />
      ))}
    </div>
  )
}
