---
/** Post card (mockup post_card): the whole card is one link; brand-template thumb until a real cover exists. */
import { Image } from 'astro:assets';
import type { Post } from '../../lib/blog';
import { postPath, categoryLabel, readingMinutes, thumbTitle, postHeadline } from '../../lib/blog';
import { formatDateFa, toFaDigits } from '../../lib/format';
interface Props {
  post: Post;
  /** home-order v1.0.1 #10: 4px dot instead of «·» between date and reading time */
  dot?: boolean;
}
const { post, dot = false } = Astro.props;
const d = post.data;
const cat = categoryLabel(d.category);
const title = postHeadline(d); // card text; the decorative thumb keeps the SEO title («صفر تا صد وام با نفیس وام», not just the brand)
---

<a class="post" href={postPath(post)}>
  {
    d.cover ? (
      <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[400, 800]} sizes="(min-width: 1024px) 360px, 100vw" class="thumb-img" loading="lazy" />
    ) : (
      <div class="thumb" aria-hidden="true">
        <small>{cat}</small>
        <span>{thumbTitle(d.title)}</span>
      </div>
    )
  }
  <div class="body">
    <span class="cat">{cat}{d.sample && ' · نمونه'}</span>
    <b>{title}</b>
    <span class="meta"><time datetime={d.date.toISOString()}>{formatDateFa(d.date)}</time>{dot ? <span class="ho-dot" aria-hidden="true" /> : ' · '}{toFaDigits(readingMinutes(post.body))} دقیقه مطالعه</span>
  </div>
</a>
