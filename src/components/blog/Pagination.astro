---
import type { Page } from 'astro';
import { toFaDigits } from '../../lib/format';
interface Props {
  page: Page<unknown>;
}
const { page } = Astro.props;
const base = page.url.first ?? page.url.current;
const href = (n: number) => (n === 1 ? base : `${base.replace(/\/$/, '')}/${n}`);
---

{page.lastPage > 1 && (
  <nav aria-label="صفحه‌بندی" class="mt-10 flex items-center justify-center gap-2">
    {page.url.prev ? (
      <a
        href={page.url.prev}
        rel="prev"
        class="inline-flex min-h-12 items-center rounded-control border border-line bg-white px-4 font-bold"
      >
        قبلی
      </a>
    ) : null}
    {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((n) => (
      <a
        href={href(n)}
        aria-current={n === page.currentPage ? 'page' : undefined}
        class:list={[
          'inline-flex size-12 items-center justify-center rounded-control border font-bold',
          n === page.currentPage ? 'border-brand-600 bg-brand-600 text-white' : 'border-line bg-white text-ink',
        ]}
      >
        {toFaDigits(n)}
      </a>
    ))}
    {page.url.next ? (
      <a
        href={page.url.next}
        rel="next"
        class="inline-flex min-h-12 items-center rounded-control border border-line bg-white px-4 font-bold"
      >
        بعدی
      </a>
    ) : null}
  </nav>
)}
