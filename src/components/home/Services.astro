---
import Section from '../ui/Section.astro';
import Card from '../ui/Card.astro';
import { SERVICES } from '../../data/services';
---

<Section
  id="services"
  kicker="خدمات نفیس وام"
  title="هر هدف مالی، یک مسیر مناسب دارد"
  lead="TODO(spec): متن و فهرست نهایی خدمات."
  defer
>
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {SERVICES.map((s) => (
      <Card as="li">
        <h3 class="text-lg font-bold">{s.t}</h3>
        <p class="mt-1 text-ink-muted">{s.d}</p>
      </Card>
    ))}
  </ul>
</Section>
