---
/** TODO(spec): real trust signals (license, partner banks, stats, testimonials). */
const items = [
  { t: 'شفافیت از ابتدا', d: 'هزینه‌ها و مراحل را پیش از اقدام می‌گوییم.' },
  { t: 'بررسی انسانی', d: 'پاسخ‌ها از روی قالب آماده نیست.' },
  { t: 'حریم امن اطلاعات', d: 'اطلاعات شما با مسئولیت نگهداری می‌شود.' },
  { t: 'همراهی واقعی', d: 'اگر گزینه‌ای مناسب نباشد، شفاف می‌گوییم.' },
];
---

<section aria-label="چرا نفیس وام" class="border-y border-line bg-white">
  <ul class="container-nf grid grid-cols-2 gap-4 py-6 lg:grid-cols-4">
    {items.map((i) => (
      <li>
        <p class="font-bold text-ink">{i.t}</p>
        <p class="text-sm text-ink-muted">{i.d}</p>
      </li>
    ))}
  </ul>
</section>
