---
import Section from '../ui/Section.astro';
import FaqList from '../FaqList.astro';
import { FAQ_ITEMS } from '../../data/faq';
interface Props {
  limit?: number;
}
const { limit = 5 } = Astro.props;
---

<Section id="faq" kicker="سوال‌های شما" title="سوالات متداول" defer>
  <FaqList items={FAQ_ITEMS.slice(0, limit)} />
  <p class="mt-6 text-center">
    <a href="/faq" class="font-bold text-brand-600 hover:underline">
      همه سوالات ›
    </a>
  </p>
</Section>
