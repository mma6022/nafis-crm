---
import ButtonLink from '../ui/ButtonLink.astro';
---

<section class="defer-render py-14 sm:py-20">
  <div class="container-nf">
    <div class="rounded-[var(--radius-xl)] bg-brand-700 px-6 py-10 text-center text-white sm:px-12 sm:py-14">
      <h2 class="text-[26px] font-extrabold sm:text-4xl">قدم بعدی با شماست</h2>
      <p class="mx-auto mt-3 max-w-xl text-brand-100">
        در کمتر از ۲ دقیقه درخواست بدهید؛ کارشناس ما برای شناخت نیازتان تماس می‌گیرد.
      </p>
      <ButtonLink href="/request" size="lg" variant="gold" class="mt-7">
        شروع درخواست وام
      </ButtonLink>
    </div>
  </div>
</section>
