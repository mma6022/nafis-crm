---
/**
 * Omid's banner set (nafis-design/banners/nafisvam → /images/home), Armita v1.0.1 `<picture>`: two sources with disjoint
 * media (mobile < 768px, desktop ≥ 768px, the kit's layout breakpoint), img = desktop. Decorative (alt="").
 * - `eager`: slide 1 = LCP (eager + fetchpriority high).
 * - `defer`: hero slides 2–3 keep their URLs in data-srcset/data-src; home-banners.js hydrates them when the slide is
 *   shown, the next one 1.5 s after load (autoplay only), and all on the first interaction — nothing is fetched early.
 *   v1.0.2: a <noscript> copy with real srcset/src sits next to it (CSS hides picture[data-defer] under html:not(.js)).
 * - otherwise (mid banners): native loading="lazy".
 */
interface Props {
  kind: 'hero' | 'mid';
  n: number;
  eager?: boolean;
  defer?: boolean;
}
const { kind, n, eager = false, defer = false } = Astro.props;
const [dw, dh, mw, mh] = kind === 'hero' ? [1440, 560, 375, 420] : [1200, 320, 375, 250];
const b = `/images/home/${kind}-${n}`;
const m = `${b}-m.webp 1x, ${b}-m@2x.webp 2x`;
const d = `${b}-d.webp 1x, ${b}-d@2x.webp 2x`;
---

{
  defer ? (
    <Fragment>
      <picture data-defer>
        <source media="(max-width: 767px)" data-srcset={m} width={mw} height={mh} />
        <source media="(min-width: 768px)" data-srcset={d} width={dw} height={dh} />
        <img data-src={`${b}-d.webp`} data-srcset={d} width={dw} height={dh} alt="" loading="lazy" decoding="async" />
      </picture>
      <noscript>
        <picture>
          <source media="(max-width: 767px)" srcset={m} width={mw} height={mh} />
          <source media="(min-width: 768px)" srcset={d} width={dw} height={dh} />
          <img src={`${b}-d.webp`} srcset={d} width={dw} height={dh} alt="" loading="lazy" decoding="async" />
        </picture>
      </noscript>
    </Fragment>
  ) : (
    <picture>
      <source media="(max-width: 767px)" srcset={m} width={mw} height={mh} />
      <source media="(min-width: 768px)" srcset={d} width={dw} height={dh} />
      {eager ? (
        <img src={`${b}-d.webp`} srcset={d} width={dw} height={dh} alt="" loading="eager" fetchpriority="high" decoding="async" />
      ) : (
        <img src={`${b}-d.webp`} srcset={d} width={dw} height={dh} alt="" loading="lazy" decoding="async" />
      )}
    </picture>
  )
}
