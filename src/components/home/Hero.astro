---
/** Home hero (mockup home.html `.hero`). h1 from home.mdx; every number from plan data (planFacts). Desktop: live sample card. */
import I from '../ui/I.astro';
import { pickerTrigger } from '../../data/experts';
import { fa, type PlanFacts } from '../../lib/plans';
interface Props {
  facts: PlanFacts;
  /** h1 from home.mdx with {planCount}; «N طرح فعال» is wrapped in <em> like the mockup */
  h1: string;
}
const { facts: f, h1 } = Astro.props;
const n = fa(f.planCount);
const [before, after] = h1.split('{planCount}');
---

<section class="hero" id="hero">
  <div class="wrap hero-grid">
    <div>
      <span class="live"><span class="dot"></span><span data-plan-count="planCount">{n}</span> طرح فعال، همین حالا</span>
      <h1>
        {
          after !== undefined ? (
            <>
              {before}
              <em>
                <span data-plan-count="planCount">{n}</span> طرح فعال
              </em>
              {after.replace(/^\s*طرح فعال/, '')}
            </>
          ) : (
            h1
          )
        }
      </h1>
      <p class="lead">
        به ۳ سؤال ساده جواب دهید تا مناسب‌ترین طرح را با <b>مبلغ قابل دریافت</b> و <b>قسط ماهانه</b>‌اش ببینید. مشاوره رایگان است و تعهدی ایجاد نمی‌کند.
      </p>
      <div class="actions">
        <a class="nf-btn nf-btn--primary nf-btn--block" href="#plan-finder" id="hero-cta">پیدا کردن طرح مناسب من <I name="arrow" /></a>
        <a class="nf-btn nf-btn--text" {...pickerTrigger('call')}><I name="phone" size={18} /> ترجیح می‌دهم تماس بگیرم</a>
      </div>
      <ul class="ticks">
        <li><span class="ok"><I name="check" /></span><span data-plan-count="amountRange">{f.amountRange}</span></li>
        <li><span class="ok"><I name="check" /></span><span data-plan-count="termRange">{f.termRange}</span></li>
        {f.hasFast && <li><span class="ok"><I name="check" /></span>بررسی برخی طرح‌ها کمتر از ۷ روز</li>}
      </ul>
    </div>
    <div class="sample d-only" aria-label="نمونه یک طرح فعال">
      <div class="sample-tag"><span class="dot"></span>نمونه یک طرح فعال، با داده زنده سامانه</div>
      <div id="sample"><slot /></div>
    </div>
  </div>
</section>
