---
/** Navy site footer. «ارتباط با ما» carries the company landline, @nafisvambot, and sales extensions (v1.2). Columns are <details>: collapsed on mobile, opened on ≥1024px by scripts/chrome.ts. */
import I from './ui/I.astro';
import Logo from './Logo.astro';
import { CONTACT, GUIDE_NAV, KEYWORD_PAGES, SITE, SOCIAL, WORK_HOURS, contactTelHref, jalaliYear } from '../lib/site';
import { fa, planFacts } from '../lib/plans';
import { LOAN_PLANS_SNAPSHOT } from '../lib/loan-plans.snapshot';
const facts = planFacts(LOAN_PLANS_SNAPSHOT);
---

<footer class="site-foot">
  <div class="container-nf">
    <div class="fgrid">
      <div class="brand">
        <a class="flogo" href="/" aria-label={SITE.name}><Logo width={154} white /></a>
        <p>برای هر مشتری یک طرح مناسب و شفاف؛ <span data-plan-count="planCount">{fa(facts.planCount)}</span> طرح فعال تسهیلات اقساطی.</p>
        <p class="legal-id">{SITE.legalName}</p>
      </div>
      <details data-foot>
        <summary>خدمات <I name="down" size={20} /></summary>
        <ul>{KEYWORD_PAGES.map((k) => <li><a href={`/${k.slug}/`}>{k.label}</a></li>)}</ul>
      </details>
      <details data-foot>
        <summary>راهنما <I name="down" size={20} /></summary>
        <ul>{GUIDE_NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
      </details>
      <details data-foot>
        <summary>ارتباط با ما <I name="down" size={20} /></summary>
        <ul>
          <li><a class="ft-tel" href={contactTelHref()} dir="ltr"><I name="phone" size={18} /><span class="ltr">{CONTACT.phoneDisplay}</span></a></li>
          <li><a class="ft-bale" href={CONTACT.baleUrl} target="_blank" rel="noopener"><I name="bale" size={18} /><span>پیام در بله <span class="ltr">@{CONTACT.baleHandle}</span></span></a></li>
          <li class="ft-ext-title">داخلی کارشناسان فروش</li>
          {CONTACT.extensions.map((e) => (
            <li><a class="ft-ext" href={contactTelHref(e.ext)}><span>{e.name}</span><span class="ext ltr" dir="ltr">داخلی {e.extFa}</span></a></li>
          ))}
          <li><a href="/request/?src=footer"><I name="callback" size={18} /><span>ثبت درخواست</span></a></li>
          <li><span class="ft-hours"><I name="clock" size={18} /><span>{WORK_HOURS.daysFa}، {WORK_HOURS.fa}</span></span></li>
          <li><address class="not-italic" data-address>{SITE.address}</address></li>
          <li><a href={SOCIAL.instagram.href} target="_blank" rel="noopener" aria-label="اینستاگرام نفیس وام"><I name="ig" size={18} /><span>اینستاگرام <span class="ltr">@{SOCIAL.instagram.handle}</span></span></a></li>
          <li>
            {/* اینماد: our self-hosted copy of the official badge (public/images/enamad.png, supplied by Mohammad) wrapped in one link to the trust seal page. Fixed size: no layout shift. */}
            <a class="enamad" href="https://trustseal.enamad.ir/?id=734294" target="_blank" rel="noopener" referrerpolicy="origin"><img src="/images/enamad.png" alt="نماد اعتماد الکترونیکی" width="120" height="120" loading="lazy" decoding="async" /></a>
          </li>
        </ul>
      </details>
    </div>
    <div class="legal">
      <span>© {jalaliYear()} {SITE.name}</span>
      <nav aria-label="حقوقی"><a href="/privacy/">حریم خصوصی</a><a href="/terms/">قوانین</a></nav>
    </div>
  </div>
</footer>
