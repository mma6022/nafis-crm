---
/** Zero-JS accordion using <details>. */
interface Props {
  items: { q: string; a: string }[];
}
import { splitMarkers } from '../lib/markers';
const { items } = Astro.props;
const rich = (t: string) => splitMarkers(t).map((x) => (x.marker ? `<span class="nf-ph">${esc(x.text)}</span>` : esc(x.text))).join('');
function esc(t: string) {
  return t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
---

<div class="mx-auto max-w-3xl space-y-3">
  {items.map((i) => (
    <details class="group rounded-card border border-line bg-white open:shadow-card">
      <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 py-3 font-bold text-ink [&::-webkit-details-marker]:hidden">
        <span set:html={rich(i.q)} />
        <span class="shrink-0 text-xl text-brand-500 transition-transform group-open:rotate-45" aria-hidden="true">
          +
        </span>
      </summary>
      <p class="px-5 pb-5 text-ink-soft" set:html={rich(i.a)} />
    </details>
  ))}
</div>
