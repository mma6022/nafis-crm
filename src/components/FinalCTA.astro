---
import { buttonClass } from './ui/styles';
interface Props {
  src?: string;
}
const { src = 'page' } = Astro.props;
---

<section class="container-nf pt-section lg:pt-section-lg" aria-labelledby="final-h">
  <div class="bg-brand-900 grid gap-4 rounded-card p-6 text-white lg:flex lg:items-center lg:justify-between lg:p-10">
    <div>
      <h2 id="final-h" class="text-h2 lg:text-h2-lg !text-white">هنوز مطمئن نیستید کدام طرح مناسب شماست؟</h2>
      <p class="text-brand-100 mt-1">یک کارشناس رایگان راهنمایی‌تان می‌کند.</p>
    </div>
    <div class="grid gap-2 sm:flex">
      <a href={`/request/?src=${src}`} class={buttonClass('gold', 'lg', 'w-full sm:w-auto')}>ثبت درخواست</a>
    </div>
  </div>
</section>
