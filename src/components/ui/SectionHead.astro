---
interface Props {
  id: string;
  title: string;
  lead?: string;
  more?: { href: string; label: string };
}
const { id, title, lead, more } = Astro.props;
---

<div class="mb-5 flex items-end justify-between gap-3 lg:mb-8">
  <div>
    <h2 id={id} class="text-h2 lg:text-h2-lg">{title}</h2>
    {lead && <p class="text-ink-muted mt-1 text-small lg:text-body">{lead}</p>}
  </div>
  {more && <a href={more.href} class="text-brand-600 inline-flex min-h-11 shrink-0 items-center text-small font-extrabold">{more.label}</a>}
</div>
