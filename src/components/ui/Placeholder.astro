---
/**
 * Labelled placeholder box (designer ANSWERS-1 §9): dashed gold box with the standard pill
 * «جای‌خالی: {label}» (rendered bracketless; marker kept in data-marker for the build check) and an optional note.
 */
interface Props {
  label: string;
  note?: string;
  minH?: string;
}
const { label, note, minH = 'min-h-24' } = Astro.props;
---

<div class:list={['ph-box', minH]} data-placeholder>
  <span class="ph">[جای‌خالی: {label}]</span>
  {note && <p>{note}</p>}
</div>
