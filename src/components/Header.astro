---
/**
 * Site header + mobile menu (mockup src/header.html). Behaviour lives in scripts/chrome.ts:
 * services dropdown, menu ⇄ x toggle, `.is-stuck` (desktop CTA turns primary once the hero is gone).
 * `minimal` = /request: `.hdr--min` (logo + phone only).
 */
import I from './ui/I.astro';
import Logo from './Logo.astro';
import { KEYWORD_PAGES, MESSENGERS, SITE } from '../lib/site';
import { fa, planFacts } from '../lib/plans';
import { LOAN_PLANS_SNAPSHOT } from '../lib/loan-plans.snapshot';
interface Props {
  /** lead `src` prefix, e.g. "home" → /request?src=home-header */
  src?: string;
  minimal?: boolean;
}
const { src = 'page', minimal = false } = Astro.props;
const facts = planFacts(LOAN_PLANS_SNAPSHOT);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const cur = (href: string) => (path === href || (href !== '/' && path.startsWith(href + '/')) ? 'page' : undefined);
const blurb = (b: string) => b.replace('{goodsCount}', fa(facts.goodsCount));
const DD_BLURB: Record<string, string> = { 'vam-ba-chek': 'با ضمانت چک صیادی' };
const NAV = [
  { href: '/plans', label: 'طرح‌ها' },
  { href: '/calculator', label: 'محاسبه قسط' },
  { href: '/blog', label: 'مجله' },
  { href: '/about', label: 'درباره ما' },
  { href: '/contact', label: 'تماس' },
];
---

<a class="sr skip" href="#main">رفتن به محتوای اصلی</a>
<header class:list={['hdr', minimal && 'hdr--min']}>
  <div class="wrap">
    <a class="logo" href="/" aria-label={`${SITE.name}، صفحه اصلی`}><Logo width={175} /></a>
    {
      !minimal && (
        <nav class="dnav" aria-label="منوی اصلی">
          <div class="dd">
            <button type="button" aria-expanded="false" aria-controls="dd-svc" id="dd-btn">
              خدمات <I name="down" size={18} />
            </button>
            <div class="dd-menu" id="dd-svc" hidden>
              {KEYWORD_PAGES.map((k) => (
                <a href={`/${k.slug}`} aria-current={cur(`/${k.slug}`)}>
                  <b>{k.label}</b>
                  <small>{blurb(DD_BLURB[k.slug] ?? k.blurb)}</small>
                </a>
              ))}
              <a class="all" href="/services">همه خدمات</a>
            </div>
          </div>
          {NAV.map((n) => (
            <a href={n.href} aria-current={cur(n.href)}>
              {n.label}
            </a>
          ))}
        </nav>
      )
    }
    {!minimal && <a class="portal d-only" href={SITE.portal}>ورود مشتریان</a>}
    <a class:list={['tel', !minimal && 'd-only']} href={SITE.tel} aria-label={`تماس با ${SITE.phoneFa}`}><I name="phone" size={18} /><span>{SITE.phoneFa}</span></a>
    {!minimal && <a class="cta" href={`/request?src=${src}-header`}>درخواست وام</a>}
    {
      !minimal && (
        <button type="button" class="icon-btn m-only" aria-label="منو" aria-expanded="false" aria-controls="mmenu" id="menu-btn">
          <I name="menu" />
        </button>
      )
    }
  </div>
</header>
{
  !minimal && (
    <div class="mmenu" id="mmenu" hidden>
      <ul>
        <li>
          <details open>
            <summary>
              طرح‌ها و خدمات <I name="down" size={20} />
            </summary>
            <ul>
              {KEYWORD_PAGES.map((k) => (
                <li>
                  <a href={`/${k.slug}`}>{k.label}</a>
                </li>
              ))}
            </ul>
          </details>
        </li>
        <li><a href="/calculator">محاسبه قسط</a></li>
        <li><a href="/how-it-works">مراحل دریافت</a></li>
        <li><a href="/blog">مجله نفیس</a></li>
        <li><a href="/about">درباره ما</a></li>
        <li><a href="/contact">تماس</a></li>
      </ul>
      <div class="mfoot">
        <a class="nf-btn nf-btn--secondary nf-btn--block" href={SITE.portal}><I name="login" /> ورود مشتریان</a>
        <a class="nf-btn nf-btn--secondary nf-btn--block" href={SITE.tel}><I name="phone" /> تماس: <span>{SITE.phoneFa}</span></a>
        <div class="msgs" aria-label="پیام‌رسان‌ها">
          <a href={MESSENGERS.whatsapp.href} data-todo="whatsapp" aria-label="واتساپ"><I name="wa" class="wa" /></a>
          <a href={MESSENGERS.telegram.href} data-todo="telegram" aria-label="تلگرام">TG</a>
          <a href={MESSENGERS.bale.href} data-todo="bale" aria-label="بله">بله</a>
        </div>
        <p style="text-align:center;margin:4px 0 0"><span class="ph">[جای‌خالی: لینک واتساپ، تلگرام و بله]</span></p>
      </div>
    </div>
  )
}
