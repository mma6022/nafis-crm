---
import type { Crumb } from '../lib/seo';
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav aria-label="مسیر صفحه" class="mb-4 text-sm text-ink-muted">
  <ol class="flex flex-wrap items-center gap-1.5">
    {items.map((c, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && (
          <span aria-hidden="true" class="text-ink-faint">
            ‹
          </span>
        )}
        {i < items.length - 1 ? (
          <a href={c.path} class="hover:text-brand-600">
            {c.name}
          </a>
        ) : (
          <span aria-current="page" class="text-ink-soft">
            {c.name}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
