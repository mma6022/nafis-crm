---
/** Breadcrumb trail (mockup `.crumbs`); BreadcrumbList JSON-LD is emitted by the page (lib/seo.ts). */
import type { Crumb } from '../lib/seo';
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<ol class="crumbs" aria-label="مسیر">
  {items.map((c, i) => <li>{i < items.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}
</ol>
