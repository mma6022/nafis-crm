---
/**
 * Shared expert picker «با کدام کارشناس تماس می‌گیرید؟» (Mohammad 2026-10-23; design: Armita CONTACT-EXPERTS.md).
 * Rendered once per page by BaseLayout as a closed native <dialog> (no layout, not in the a11y tree until opened).
 * Every `[data-experts="call|whatsapp|telegram|bale"]` trigger opens it (behaviour: src/scripts/expert-picker.ts, loaded
 * on first interaction by scripts/chrome.ts): one row per expert (fixed order) opening that channel. Rows for a channel an
 * expert does not have are not rendered. No raw phone numbers. Bottom sheet < 768px, 360px popover anchored to the
 * trigger ≥ 768px. Data: src/data/experts.ts.
 */
import I from '../ui/I.astro';
import { ALL_CHANNELS, CHANNELS, EXPERTS, EXPERT_ROLE, PICKER_HOURS, PICKER_TITLE, expertLink } from '../../data/experts';
const initial = (n: string) => n.replace(/^(خانم|آقای)\s*/, '').charAt(0);
const ext = (ch: string) => (ch === 'call' ? {} : { target: '_blank', rel: 'noopener' });
---

<dialog id="xp" class="xp" aria-labelledby="xp-h" aria-describedby="xp-via" aria-modal="true" data-mode="call" {...Object.fromEntries(ALL_CHANNELS.map((ch) => [`data-via-${ch}`, CHANNELS[ch].via]))}>
  <div class="xp-card">
    <div class="xp-grab" aria-hidden="true"></div>
    <div class="xp-head">
      <span class="xp-ch" aria-hidden="true"><svg class="i" focusable="false"><use id="xp-ic" href="#i-phone"></use></svg></span>
      <div class="xp-tt">
        <h2 id="xp-h">{PICKER_TITLE}</h2>
        <p class="xp-via" id="xp-via">{CHANNELS.call.via}</p>
      </div>
      <button type="button" class="xp-x" data-xp-close aria-label="بستن"><I name="x" /></button>
    </div>
    <ul class="xp-list">
      {
        EXPERTS.map((e) => (
          <li>
            {ALL_CHANNELS.map((ch) => {
              const href = expertLink(e, ch);
              return (
                href && (
                  <a class="xp-row" data-ch={ch} href={href} hidden={ch !== 'call'} {...ext(ch)} aria-label={`${e.name}، ${EXPERT_ROLE} — ${CHANNELS[ch].action} (${CHANNELS[ch].label})`}>
                    <span class="xp-av" aria-hidden="true">{initial(e.name)}</span>
                    <span class="xp-who">
                      <b>{e.name}</b>
                      <small>{EXPERT_ROLE}</small>
                    </span>
                    <span class={`xp-go xp-go--${ch}`} aria-hidden="true">
                      <I name={CHANNELS[ch].icon} size={18} />
                      {CHANNELS[ch].action}
                    </span>
                  </a>
                )
              );
            })}
          </li>
        ))
      }
    </ul>
    <p class="xp-hours"><I name="clock" size={18} /> {PICKER_HOURS}</p>
  </div>
</dialog>
