---
/** MDX `<Steps items />` → mockup `ol.steps` (numbered by CSS counter). */
import { splitMarkers } from '../../lib/markers';
interface Props {
  items: string[];
}
const { items } = Astro.props;
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const rich = (t: string) => splitMarkers(t).map((x) => (x.marker ? `<span class="ph">${esc(x.text)}</span>` : esc(x.text))).join('');
---

<ol class="steps not-prose">{items.map((t) => <li><span set:html={rich(t)} /></li>)}</ol>
