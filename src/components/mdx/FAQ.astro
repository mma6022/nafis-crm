---
/** MDX `<FAQ />`: the page's frontmatter FAQ (Astro.locals.faq). The MDX heading above it is the section title. First item open (mockup). */
import FaqList from '../FaqList.astro';
const items = Astro.props.items ?? Astro.locals.faq ?? [];
---

{items.length > 0 && <div class="not-prose"><FaqList items={items} openFirst={1} /></div>}
