---
/**
 * In-content CTA (mockup `.inline-cta`): lead line + primary button + «تماس با کارشناس». In blog posts it sits at the
 * end of the 2nd H2 section (enforced by tests/content-rules.test.ts).
 */
import I from '../ui/I.astro';
import { pickerTrigger } from '../../data/experts';
interface Props {
  primary: string;
  href?: string;
  /** text link instead of «تماس با کارشناس»: own href, or «واتساپ» */
  secondary?: string;
  secondaryHref?: string;
  /** lead line; defaults per page type */
  lead?: string;
}
const { primary, secondary, secondaryHref } = Astro.props;
const page = (Astro.url.pathname.replace(/^\/+|\/+$/g, '').split('/').pop() || 'home').replace(/[^a-z0-9_-]/g, '') || 'home';
const blog = Astro.url.pathname.startsWith('/blog/');
const href = Astro.props.href ?? `/request/?src=${blog ? 'blog-' : ''}${page}-inline`;
const lead =
  Astro.props.lead ??
  (blog
    ? Astro.locals.ctaLead ?? 'طرح‌های فعلی را با مبلغ و قسط واقعی ببینید.'
    : page === 'vam-fori'
      ? 'سریع‌ترین طرح متناسب با شما را کارشناس ما پیشنهاد می‌دهد.'
      : 'طرح متناسب با شما را کارشناس ما پیشنهاد می‌دهد.');
const sec = secondaryHref
  ? { attrs: { href: secondaryHref }, text: secondary!, icon: null }
  : { attrs: pickerTrigger('call'), text: 'تماس با کارشناس', icon: 'phone' as const };
---

<div class="inline-cta not-prose">
  <p>{lead}</p>
  <div class="row">
    <a class="nf-btn nf-btn--primary" href={href}>{primary} <I name="arrow" /></a>
    <a class="nf-btn nf-btn--text" {...sec.attrs}>{sec.icon && <I name={sec.icon} size={18} />} {sec.text}</a>
  </div>
</div>
