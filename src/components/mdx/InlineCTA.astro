---
/**
 * In-content CTA (mockup `.inline-cta`): lead line + ONE primary button (default /request/?src=…-inline). HANDOFF §0
 * v1.2: no «تماس با کارشناس» / picker. A second text link renders only with an explicit `secondaryHref` (never a
 * call / messenger link) and never with `noContact`. In blog posts it sits at the end of the 2nd H2 section
 * (enforced by tests/content-rules.test.ts).
 */
import I from '../ui/I.astro';
interface Props {
  primary: string;
  href?: string;
  /** optional second text link (needs secondaryHref) */
  secondary?: string;
  secondaryHref?: string;
  /** copy B1–B3: single-button CTA (also the default when no secondaryHref is given) */
  noContact?: boolean;
  /** lead line; defaults per page type */
  lead?: string;
}
const { primary, secondary, secondaryHref, noContact = false } = Astro.props;
const page = (Astro.url.pathname.replace(/^\/+|\/+$/g, '').split('/').pop() || 'home').replace(/[^a-z0-9_-]/g, '') || 'home';
const blog = Astro.url.pathname.startsWith('/blog/');
const href = Astro.props.href ?? `/request/?src=${blog ? 'blog-' : ''}${page}-inline`;
const lead =
  Astro.props.lead ??
  (blog
    ? Astro.locals.ctaLead ?? 'طرح‌های فعلی را با مبلغ واریزی و مدت بازپرداخت ببینید.'
    : page === 'vam-fori'
      ? 'سریع‌ترین طرح متناسب با شما را کارشناس ما پیشنهاد می‌دهد.'
      : 'طرح متناسب با شما را کارشناس ما پیشنهاد می‌دهد.');
const blocked = (h: string) => {
  const s = h.replace(/\/+$/, '');
  if (/^tel:02191303819(?:,21[0-2])?$/.test(s) || s === 'https://ble.ir/nafisvambot') return false;
  return /^(tel|sms|whatsapp|tg|bale):|wa\.me|t\.me|ble\.ir|#experts/.test(h);
};
const sec = !noContact && secondary && secondaryHref && !blocked(secondaryHref) ? { href: secondaryHref, text: secondary } : null;
---

<div class="inline-cta not-prose">
  <p>{lead}</p>
  <div class="row">
    <a class="nf-btn nf-btn--primary" href={href}>{primary} <I name="arrow" /></a>
    {sec && <a class="nf-btn nf-btn--text" href={sec.href}>{sec.text}</a>}
  </div>
</div>
