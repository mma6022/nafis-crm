---
/** MDX `<TOC />` → mockup `details.toc.m-toc` (mobile only; desktop uses the sticky aside TOC). Collapsed. */
import I from '../ui/I.astro';
import { fa } from '../../lib/plans';
const hs = (Astro.locals.headings ?? []).filter((h: { depth: number }) => h.depth === 2);
---

{
  hs.length > 1 && (
    <details class="toc m-toc not-prose">
      <summary>
        فهرست مطالب ({fa(hs.length)} بخش)
        <I name="down" size={20} />
      </summary>
      <ol>
        {hs.map((h: { slug: string; text: string }) => (
          <li>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ol>
    </details>
  )
}
