---
/**
 * MDX `<PlanCards ids|filter max />` → `.cards.plancards` (mockup md_to_html): one card per plan at its highest
 * payout (designer byId), first = «پیشنهاد ما». Guarantee filters render nothing until the CRM export carries
 * guaranteeTypes (the page's PlanFinder covers the gap). Never "no plan".
 */
import { PlanCard } from '../islands/PlanCard';
import { LOAN_PLANS_SNAPSHOT } from '../../lib/loan-plans.snapshot';
import { byId, combos, planFilter } from '../../lib/plans';
interface Props {
  ids?: number[];
  filter?: string;
  max?: number;
}
const { ids, filter, max = 3 } = Astro.props;
const all = LOAN_PLANS_SNAPSHOT;
const pred = ids ? (p: (typeof all)[number]) => ids.includes(p.id) : filter ? planFilter(filter, all) : () => true;
const list = combos(pred ? all.filter(pred) : []);
const idList = ids ?? [...new Set(list.map((c) => c.id))];
const cards = idList
  .map((id) => byId(list, id))
  .filter((c): c is NonNullable<typeof c> => !!c)
  .sort((a, b) => (ids ? 0 : b.payout - a.payout))
  .slice(0, Math.min(max, 3));
const page = (Astro.url.pathname.replace(/^\/+|\/+$/g, '').split('/').pop() || 'home').replace(/[^a-z0-9_-]/g, '') || 'home';
---

{
  cards.length > 0 ? (
    <div class={`cards plancards n${cards.length} not-prose`}>
      {cards.map((c, i) => (
        <PlanCard c={c} featured={i === 0} src={`${page}-cards`} />
      ))}
    </div>
  ) : (
    <Fragment set:html={`<!-- PlanCards filter="${filter}": waiting for guaranteeTypes in loan-plans.json -->`} />
  )
}
