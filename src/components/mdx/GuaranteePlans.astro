---
/**
 * MDX `<GuaranteePlans page="no-guarantor|no-cheque|cheque|promissory|fast-no-guarantor|fast-no-cheque" />`:
 * the plans that TRULY meet a guarantee page's condition (data/plan-guarantees.ts → qualifiesFor). Strict: a plan
 * with unknown guarantee data is never listed and nothing is relaxed. Zero plans → an honest empty state (`empty`
 * slot text or the default), never a fake list. Every row carries data-plan-id; scripts/check-guarantees.mjs
 * re-checks the built HTML against the same rules.
 *
 * Fast pages (/vam-fori-bedun-chek/, /vam-fori-bedun-zamen/; copy A2/A3 2026-10-28): `fast-no-cheque` /
 * `fast-no-guarantor` never ship an empty state. Both show the FASTEST plans meeting the base condition
 * (lib/plans `fastestGuaranteePlans`, max 3, sorted by real grantDays; no-guarantor ties by the highest مبلغ واریزی
 * without a guarantor, no repeated plan name), promise no time (no «زمان بررسی» line) and are followed by the
 * «مشاوره‌ی رایگان» entry into the /request/ wizard (site-credit-noinst v1.1: the callback form is gone).
 * On the no-cheque / no-guarantor pages (and their fast pages) no row shows a review time.
 */
import { LOAN_PLANS_SNAPSHOT } from '../../lib/loan-plans.snapshot';
import { DAYS_LABEL, MODE_LABEL, cleanPlanName, fastestGuaranteePlans, guaranteePagePlans } from '../../lib/plans';
import RequestCTA from '../RequestCTA.astro';
import { whyFor, type GuaranteePage } from '../../data/plan-guarantees';
import I from '../ui/I.astro';
interface Props {
  page: GuaranteePage;
  /** text for the empty state */
  empty?: string;
}
const { page, empty } = Astro.props;
const fastOf = page === 'fast-no-cheque' ? 'no-cheque' : page === 'fast-no-guarantor' ? 'no-guarantor' : null;
/** fast pages: fastest ≤3 by grantDays (lib/plans fastestGuaranteePlans) */
const list = fastOf ? fastestGuaranteePlans(LOAN_PLANS_SNAPSHOT, fastOf, 3) : guaranteePagePlans(LOAN_PLANS_SNAPSHOT, page);
/** no review time on the no-cheque / no-guarantor pages (incl. their fast sections) */
const showTime = !['no-cheque', 'no-guarantor', 'fast-no-cheque', 'fast-no-guarantor'].includes(page);
const src = (Astro.url.pathname.replace(/^\/+|\/+$/g, '').split('/').pop() || 'home').replace(/[^a-z0-9_-]/g, '') || 'home';
/** «ستاره آبی» exists 3×: tell the rows apart by bank / platform */
const names = list.map((p) => cleanPlanName(p.name));
const dup = (n: string) => names.filter((x) => x === n).length > 1;
const via = (p: (typeof list)[number]) => [p.bankName, p.platformName].map((s) => s.replace(/\s+/g, ' ').trim()).filter(Boolean).join(' / ');
---

{
  list.length > 0 ? (
    <div class="gplans-wrap not-prose" data-guarantee-page={page} data-count={list.length} data-fastest-of={fastOf ?? undefined}>
    <ul class="gplans">
      {list.map((p) => (
        <li class="gplan" data-plan-id={p.id}>
          <div class="gp-head">
            <b class="gp-name">
              {cleanPlanName(p.name)}
              {dup(cleanPlanName(p.name)) && via(p) && <span class="gp-via"> ({via(p)})</span>}
            </b>
            {p.retireesOnly && <span class="nf-badge nf-badge--brand">ویژه‌ی بازنشستگان</span>}
          </div>
          <p class="gp-why"><I name="check" size={18} /> <span>{whyFor(p.id, fastOf ?? page)}</span></p>
          <p class="gp-meta">
            {showTime && <span>زمان بررسی: {DAYS_LABEL[p.grantDays] ?? p.grantDays}</span>}
            <span>روش: {MODE_LABEL[p.processMode] ?? p.processMode}</span>
            {p.documentsNote && <span>مدارک: {p.documentsNote}</span>}
          </p>
          <a class="nf-btn nf-btn--secondary gp-btn" href={`/request/?plan=${p.id}&src=${encodeURIComponent(src + '-guarantee')}`}>درخواست این طرح</a>
        </li>
      ))}
    </ul>
    {fastOf && (
      <div class="gplans-cb">
        <RequestCTA titleTag="h3" primary={false} src={`${src}-fastest-callback`} lead="عجله دارید؟ درخواست‌تان را ثبت کنید؛ کارشناس نفیس وام سریع‌ترین راه متناسب با شرایط شما را رایگان با شما مرور می‌کند." />
      </div>
    )}
    </div>
  ) : (
    <div class="gplans-empty not-prose" data-guarantee-page={page} data-count="0">
      <p>{empty ?? 'در حال حاضر طرح فعالی با این شرط نداریم. درخواست‌تان را ثبت کنید تا کارشناس نزدیک‌ترین راه را بگوید.'}</p>
      <a class="nf-btn nf-btn--secondary" href={`/request/?src=${encodeURIComponent(src + '-empty')}`}>ثبت درخواست</a>
    </div>
  )
}
